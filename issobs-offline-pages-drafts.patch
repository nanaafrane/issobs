+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="robots" content="noindex">
+<title>Offline · ISSOBS</title>
+<!--
+  Shown by the service worker (public/sw.js) when a page can't be reached, instead of the browser's

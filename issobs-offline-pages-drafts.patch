+        });
+    }
+    idb('issobs-outbox', 'items', function (s) { return s.getAll(); }).then(function (rows) {
+        if (rows.length) $('outbox').innerHTML = '<div class="waiting">' + rows.length + ' attendance sign-in(s) are saved on this device, waiting for signal. They are sent automatically.</div>';
+    });
+})();
+</script>
+</body>
+</html>

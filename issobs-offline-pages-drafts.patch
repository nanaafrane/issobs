+<style>
+    :root { --ink: #22303e; --text: #384551; --muted: #8592a3; --line: #eceef1; --brand: #696cff; --warn: #ff9f43; --warnbg: #fff2d6; }
+    * { box-sizing: border-box; }
+    body { margin: 0; font-family: "Public Sans", -apple-system, "Segoe UI", Roboto, Arial, sans-serif; background: #f5f5f9; color: var(--text); font-size: 15px; line-height: 1.5; }
+    header { background: var(--ink); color: #fff; padding: 14px 20px; font-weight: 700; letter-spacing: .02em; }
+    header small { display: block; font-weight: 400; opacity: .7; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
+    main { max-width: 680px; margin: 0 auto; padding: 28px 16px 40px; }
+    .box { background: #fff; border-radius: 14px; box-shadow: 0 6px 30px rgba(34,48,62,.08); padding: 28px; }
+    h1 { margin: 0 0 4px; font-size: 26px; color: var(--ink); display: flex; align-items: center; gap: 12px; }
+    .dot { width: 13px; height: 13px; border-radius: 50%; background: var(--warn); box-shadow: 0 0 0 5px rgba(255,159,67,.2); flex: none; }
+    .lead { color: #646e78; margin: 0 0 6px; }
+    .page { color: var(--muted); font-size: 13px; word-break: break-all; margin: 0 0 18px; }
+    h2 { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 22px 0 6px; }
+    ul { margin: 0; padding-left: 20px; } li { margin: 5px 0; }
+    a { color: var(--brand); font-weight: 600; }
+    .waiting { background: var(--warnbg); color: #8a5a00; border-radius: 8px; padding: 10px 12px; font-weight: 600; margin-top: 14px; }
+    .foot { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 24px; border-top: 1px solid var(--line); padding-top: 16px; }

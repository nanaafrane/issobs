+
+    if (user) {
+        idb('issobs-drafts', 'drafts', function (s) { return s.index('user').getAll(String(user.id)); }).then(function (rows) {
+            if (!rows.length) return;
+            rows.sort(function (a, b) { return b.savedAt - a.savedAt; });
+            $('drafts').innerHTML = '<h2>Drafts on this device' + (user.name ? ' (' + esc(user.name) + ')' : '') + '</h2><ul>' + rows.slice(0, 10).map(function (r) {

+    $bar->finish();
+    $this->newLine();
+    $this->info("Checked {$result['clients']} client(s), posted {$result['entries']} entr" . ($result['entries'] === 1 ? 'y' : 'ies') . '.');
+})->purpose('Post invoices, receipts and credit to the client ledger (safe to re-run)');

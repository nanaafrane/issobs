diff --git a/app/Services/Receipts/ReceiptVoider.php b/app/Services/Receipts/ReceiptVoider.php
new file mode 100644
index 0000000..baf90c9
--- /dev/null
+++ b/app/Services/Receipts/ReceiptVoider.php
@@ -0,0 +1,78 @@
+<?php
+
+namespace App\Services\Receipts;
+
+use App\Models\BankTransaction;
+use App\Models\Collection;
+use App\Models\Receipt;
+use App\Models\ReceiptVoid;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+
+/**
+ * Voids a receipt instead of silently deleting it.
+ *
+ *  - a reason is required, and who/when is recorded;
+ *  - a full copy (receipt, what it paid, collection, bank lines) is kept in receipt_voids;
+ *  - cheque/transfer money is reversed out of the bank with a visible reversal line;
+ *  - the invoices it paid are re-derived from the receipts that remain;
+ *  - the client ledger gets reversal entries dated today, so a statement already
+ *    sent still reads the same and the next one shows "voided" on the day it happened.
+ *
+ * The receipt then leaves the receipts table, so every existing report, dashboard
+ * and export keeps working without having to filter voided rows out.
+ */
+class ReceiptVoider
+{
+    public function __construct(
+        private BankPosting $bankPosting,
+        private InvoiceSettlement $settlement,
+        private ClientLedger $ledger,
+    ) {
+    }
+
+    public function void(Receipt $receipt, string $reason): ReceiptVoid
+    {
+        $reason = trim($reason);
+        if (mb_strlen($reason) < 5) {
+            throw ValidationException::withMessages(['void_reason' => 'Give a reason for voiding this receipt (at least 5 characters).']);
+        }
+
+        return DB::transaction(function () use ($receipt, $reason) {
+            $receipt = Receipt::whereKey($receipt->id)->lockForUpdate()->firstOrFail();
+            $collection = Collection::where('receipt_id', $receipt->id)->first();
+
+            if ($collection && strcasecmp((string) $collection->status, 'deposited') === 0) {
+                throw ValidationException::withMessages(['void_reason' => 'The cash on this receipt has already been deposited, so it cannot be voided here.']);
+            }
+
+            $money = round(array_sum(array_map(fn ($f) => (float) $receipt->{$f}, ClientLedger::MONEY_FIELDS)), 2);
+            $void = ReceiptVoid::create([
+                'receipt_id' => $receipt->id,
+                'client_id' => $receipt->client_id,
+                'amount' => $money,
+                'reason' => mb_substr($reason, 0, 500),
+                'voided_by' => Auth::id(),
+                'snapshot' => [
+                    'receipt' => $receipt->getAttributes(),
+                    'allocations' => $receipt->allocations()->get()->map->getAttributes()->all(),
+                    'collection' => $collection?->getAttributes(),
+                    'bank_lines' => BankTransaction::where('receipt_id', $receipt->id)->get()->map->getAttributes()->all(),
+                ],
+            ]);
+
+            $this->bankPosting->reverse($receipt, 'Receipt voided: ' . $reason);
+            $collection?->delete();
+            $this->settlement->release($receipt);
+            $clientId = $receipt->client_id;
+            $receipt->delete();
+
+            if ($clientId) {
+                $this->ledger->sync($clientId, 'Receipt FWSSR' . $receipt->id . ' voided: ' . $reason);
+            }
+
+            return $void;
+        });
+    }
+}
diff --git a/app/Services/Receipts/ReceivablesAging.php b/app/Services/Receipts/ReceivablesAging.php
new file mode 100644
index 0000000..1f1ce03
--- /dev/null
+++ b/app/Services/Receipts/ReceivablesAging.php
@@ -0,0 +1,100 @@
+<?php
+
+namespace App\Services\Receipts;
+
+use App\Models\Client;
+use App\Models\Receipt;
+use App\Models\ReceiptAllocation;
+use Carbon\Carbon;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Aged receivables: what every client still owes, by how overdue it is.
+ *
+ * "Owed" on an invoice = invoice total − everything settled against it
+ * (the same figure as the statement of account's open invoices), so this
+ * report and the statements always agree. Overdue days count from the
+ * invoice due date (old invoices with no due date: end of the month after
+ * the invoice month). Unused client credit is shown next to it and netted off.
+ */
+class ReceivablesAging
+{
+    public const BUCKETS = [
+        'current' => 'Not yet due',
+        'd30' => '1–30 days',
+        'd60' => '31–60 days',
+        'd90' => '61–90 days',
+        'd90plus' => 'Over 90 days',
+    ];
+
+    /**
+     * @param  array<int>|null  $fieldIds  limit to these field offices (null = all)
+     */
+    public function build(?array $fieldIds = null, ?Carbon $asOf = null): array
+    {
+        $asOf = ($asOf ?? now())->copy()->startOfDay();
+
+        $settled = ReceiptAllocation::selectRaw('invoice_id, SUM(settled) as settled')->groupBy('invoice_id');
+        $invoices = DB::table('invoices')
+            ->join('clients', 'clients.id', '=', 'invoices.client_id')
+            ->leftJoinSub($settled, 's', 's.invoice_id', '=', 'invoices.id')
+            ->when($fieldIds !== null, fn ($q) => $q->whereIn('clients.field_id', $fieldIds ?: [0]))
+            ->whereRaw('invoices.total - COALESCE(s.settled, 0) > 0.004')
+            ->get(['invoices.id', 'invoices.client_id', 'invoices.total', 'invoices.due_date', 'invoices.invoice_month', DB::raw('COALESCE(s.settled, 0) as settled')]);
+
+        $credit = Receipt::where('unapplied_amount', '>', 0)
+            ->when($fieldIds !== null, fn ($q) => $q->whereHas('client', fn ($c) => $c->whereIn('field_id', $fieldIds ?: [0])))
+            ->selectRaw('client_id, SUM(unapplied_amount) as credit')->groupBy('client_id')
+            ->pluck('credit', 'client_id');
+
+        $rows = [];
+        foreach ($invoices as $inv) {
+            $owed = round((float) $inv->total - (float) $inv->settled, 2);
+            $due = $inv->due_date
+                ? Carbon::parse($inv->due_date)->startOfDay()
+                : Carbon::parse($inv->invoice_month)->addMonthNoOverflow()->endOfMonth()->startOfDay();
+            $days = $asOf->gt($due) ? (int) $due->diffInDays($asOf) : 0;
+            $bucket = match (true) {
+                $days <= 0 => 'current',
+                $days <= 30 => 'd30',
+                $days <= 60 => 'd60',
+                $days <= 90 => 'd90',
+                default => 'd90plus',
+            };
+
+            $row = &$rows[$inv->client_id];
+            $row ??= array_fill_keys(array_keys(self::BUCKETS), 0.0) + ['client_id' => $inv->client_id, 'owed' => 0.0, 'invoices' => 0, 'oldest_days' => 0];
+            $row[$bucket] = round($row[$bucket] + $owed, 2);
+            $row['owed'] = round($row['owed'] + $owed, 2);
+            $row['invoices']++;
+            $row['oldest_days'] = max($row['oldest_days'], $days);
+            unset($row);
+        }
+
+        // Clients with credit but nothing owed still appear (they are owed money back / ahead).
+        foreach ($credit as $clientId => $amount) {
+            $rows[$clientId] ??= array_fill_keys(array_keys(self::BUCKETS), 0.0) + ['client_id' => $clientId, 'owed' => 0.0, 'invoices' => 0, 'oldest_days' => 0];
+        }
+
+        $clients = Client::with('field')->whereIn('id', array_keys($rows))->get()->keyBy('id');
+        foreach ($rows as $id => &$row) {
+            $c = $clients[$id] ?? null;
+            $row['client'] = $c ? ($c->business_name ?: $c->name) : 'Client #' . $id;
+            $row['contact'] = $c?->name;
+            $row['field'] = $c?->field?->name;
+            $row['credit'] = round((float) ($credit[$id] ?? 0), 2);
+            $row['net'] = round($row['owed'] - $row['credit'], 2);
+        }
+        unset($row);
+
+        $rows = collect($rows)->sortByDesc('net')->values();
+        $totals = array_fill_keys(array_merge(array_keys(self::BUCKETS), ['owed', 'credit', 'net']), 0.0);
+        foreach ($rows as $row) {
+            foreach ($totals as $k => $v) {
+                $totals[$k] = round($v + $row[$k], 2);
+            }
+        }
+
+        return ['as_of' => $asOf, 'rows' => $rows, 'totals' => $totals];
+    }

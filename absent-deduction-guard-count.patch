diff --git a/app/Support/InvoiceGuards.php b/app/Support/InvoiceGuards.php
new file mode 100644
index 0000000..17c7c04
--- /dev/null
+++ b/app/Support/InvoiceGuards.php
@@ -0,0 +1,52 @@
+<?php
+
+namespace App\Support;
+
+use App\Models\InvoiceData;
+use App\Models\Service;
+
+/**
+ * The one place that decides what "number of guards on an invoice" means.
+ *
+ * Only invoice lines flagged counts_as_guards are headcount. Deduction lines
+ * (e.g. ABSENT DEDUCTION) keep their quantity for pricing but are not guards.
+ */
+class InvoiceGuards
+{
+    /**
+     * Total guards across a collection / array of Invoice models (or plain ids).
+     */
+    public static function total(iterable $invoices): float
+    {
+        $ids = [];
+        foreach ($invoices as $invoice) {
+            $ids[] = is_object($invoice) ? $invoice->id : $invoice;
+        }
+
+        if ($ids === []) {
+            return 0.0;
+        }
+
+        return (float) InvoiceData::guards()->whereIn('invoice_id', $ids)->sum('quantity');
+    }
+
+    /**
+     * Names of services whose quantity is NOT headcount.
+     *
+     * @return array<int, string>
+     */
+    public static function nonHeadcountServices(): array
+    {
+        return Service::where('counts_as_guards', false)->pluck('name')->all();
+    }
+
+    /**
+     * Flag to store on an invoice line for the given service name.
+     *
+     * @param array<int, string> $nonHeadcount result of nonHeadcountServices()
+     */
+    public static function flagFor(?string $serviceName, array $nonHeadcount): bool
+    {
+        return ! in_array($serviceName, $nonHeadcount, true);
+    }
+}
diff --git a/database/migrations/2026_10_10_090000_add_counts_as_guards_to_services_and_invoice_data.php b/database/migrations/2026_10_10_090000_add_counts_as_guards_to_services_and_invoice_data.php
new file mode 100644
index 0000000..2cba53f
--- /dev/null
+++ b/database/migrations/2026_10_10_090000_add_counts_as_guards_to_services_and_invoice_data.php
@@ -0,0 +1,51 @@
+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+/**
+ * invoice_data.quantity is both the pricing multiplier (quantity x unit_price)
+ * and, in every report, the number of guards billed. A deduction line such as
+ * "ABSENT DEDUCTION" needs a quantity (the absent units) but those units are not
+ * guards, so reports were showing extra guards that were never added.
+ *
+ * counts_as_guards says whether a line's quantity is headcount. It lives on the
+ * service (the setting) and is copied onto each invoice line when the invoice is
+ * saved, so renaming or re-flagging a service later never rewrites old invoices.
+ */
+return new class extends Migration
+{
+    public function up(): void
+    {
+        Schema::table('services', function (Blueprint $table) {
+            $table->boolean('counts_as_guards')->default(true)->after('name');
+        });
+
+        Schema::table('invoice_data', function (Blueprint $table) {
+            $table->boolean('counts_as_guards')->default(true)->after('service_name');
+        });
+
+        // Back-fill: any service / invoice line whose name contains "absent" is a deduction.
+        // Review `SELECT DISTINCT service_name FROM invoice_data` before running in production.
+        DB::table('services')
+            ->whereRaw('LOWER(name) LIKE ?', ['%absent%'])
+            ->update(['counts_as_guards' => false]);
+
+        DB::table('invoice_data')
+            ->whereRaw('LOWER(service_name) LIKE ?', ['%absent%'])
+            ->update(['counts_as_guards' => false]);
+    }
+
+    public function down(): void
+    {
+        Schema::table('invoice_data', function (Blueprint $table) {
+            $table->dropColumn('counts_as_guards');
+        });
+
+        Schema::table('services', function (Blueprint $table) {
+            $table->dropColumn('counts_as_guards');
+        });
+    }
+};

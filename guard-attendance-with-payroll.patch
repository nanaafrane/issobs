@@ -0,0 +1,17 @@
+<?php
+
+namespace App\Support\Attendance;
+
+class Geo
+{
+    /** Great-circle distance in metres (haversine). */
+    public static function metres(float $lat1, float $lng1, float $lat2, float $lng2): float
+    {
+        $r = 6371000.0;
+        $dLat = deg2rad($lat2 - $lat1);
+        $dLng = deg2rad($lng2 - $lng1);
+        $a = sin($dLat / 2) ** 2 + cos(deg2rad($lat1)) * cos(deg2rad($lat2)) * sin($dLng / 2) ** 2;
+
+        return 2 * $r * asin(min(1.0, sqrt($a)));
+    }
+}
diff --git a/app/Support/Attendance/KioskRecorder.php b/app/Support/Attendance/KioskRecorder.php
new file mode 100644
index 0000000..c4b88b0
--- /dev/null
+++ b/app/Support/Attendance/KioskRecorder.php
@@ -0,0 +1,96 @@
+<?php
+
+namespace App\Support\Attendance;
+
+use App\Models\Attendance;
+use App\Models\Client;
+use App\Models\employee;
+use App\Models\User;
+use Carbon\Carbon;
+use Carbon\CarbonInterface;
+
+/**
+ * Supervisor kiosk: a logged-in supervisor at the site marks guards on their own
+ * phone (tap the guard, or scan the guard's ID-card QR). For guards without a
+ * smartphone, or when a guard's phone is dead.
+ *
+ * The supervisor's login is the proof of who marked it; the supervisor's GPS is
+ * the proof it was done at the site. A mark made away from the site (or with no
+ * location) is held for review like a guard's own scan.
+ */
+class KioskRecorder
+{
+    /**
+     * @param  array{latitude?:mixed, longitude?:mixed, accuracy?:mixed, device_id?:string}  $where
+     * @return array{ok: bool, status?: string, message: string}
+     */
+    public static function record(Client $client, employee $guard, string $date, string $shift, string $status, User $supervisor, array $where, ?CarbonInterface $at = null): array
+    {
+        $at = Carbon::instance($at ?? now());
+
+        if (! Roster::isPosted($guard, $client)) {
+            return ['ok' => false, 'message' => $guard->name . ' is not posted to this client.'];
+        }
+        if (! in_array($guard->status, Roster::ACTIVE_STATUSES, true)) {
+            return ['ok' => false, 'message' => $guard->name . '\'s employee record is not active.'];
+        }
+
+        $flags = [];
+        $lat = is_numeric($where['latitude'] ?? null) ? round((float) $where['latitude'], 7) : null;
+        $lng = is_numeric($where['longitude'] ?? null) ? round((float) $where['longitude'], 7) : null;
+        $accuracy = is_numeric($where['accuracy'] ?? null) ? (int) round((float) $where['accuracy']) : null;
+        $distance = null;
+
+        if ($status === Attendance::PRESENT) {
+            if ($lat === null || $lng === null) {
+                $flags[] = 'Supervisor\'s phone did not share its location';
+            } elseif ($client->latitude !== null && $client->longitude !== null) {
+                $distance = (int) round(Geo::metres((float) $client->latitude, (float) $client->longitude, $lat, $lng));
+                $allowed = (int) ($client->attendance_radius_m ?: 200) + min($accuracy ?? 0, 100);
+                if ($distance > $allowed) {
+                    $flags[] = 'Supervisor marked it ' . $distance . ' m from the site (allowed ' . $allowed . ' m)';
+                }
+            }
+        }
+
+        $existing = Attendance::where('employee_id', $guard->id)->where('work_date', $date)->where('shift', $shift)->first();
+        if ($existing && (int) $existing->client_id !== (int) $client->id) {
+            return ['ok' => false, 'message' => $guard->name . ' is already recorded at another client for this shift.'];
+        }
+        if ($existing && $existing->source === 'scan' && $existing->status === Attendance::PRESENT && $status === Attendance::PRESENT) {
+            return ['ok' => true, 'status' => Attendance::PRESENT, 'message' => $guard->name . ' already signed in with their own phone at ' . $existing->checked_in_at?->format('H:i') . '.'];
+        }
+
+        $finalStatus = $flags ? Attendance::PENDING : $status;
+        $values = [
+            'client_id' => $client->id,
+            'status' => $finalStatus,
+            'checked_in_at' => $at,
+            'latitude' => $lat,
+            'longitude' => $lng,
+            'accuracy_m' => $accuracy,
+            'distance_m' => $distance,
+            'flags' => $flags ?: null,
+            'marked_by' => $supervisor->id,
+            'note' => 'Marked on supervisor kiosk by ' . $supervisor->name,
+        ];
+
+        if ($existing) {
+            // A guard's own scan held for review, confirmed in person at the site, counts as reviewed.
+            if ($existing->status === Attendance::PENDING && ! $flags) {
+                $values += ['reviewed_by' => $supervisor->id, 'reviewed_at' => $at];
+            }
+            $existing->fill($values + ['source' => $existing->source === 'scan' ? 'scan' : 'kiosk'])->save();
+        } else {
+            Attendance::create($values + [
+                'employee_id' => $guard->id, 'work_date' => $date, 'shift' => $shift, 'source' => 'kiosk',
+                'device_id' => preg_match('/^[A-Za-z0-9-]{16,64}$/', (string) ($where['device_id'] ?? '')) ? $where['device_id'] : null,
+            ]);
+        }
+
+        $label = strtolower(Attendance::LABELS[$finalStatus]);
+
+        return ['ok' => true, 'status' => $finalStatus,
+            'message' => $flags ? $guard->name . ': saved, but held for review (' . implode('; ', $flags) . ').' : $guard->name . ': ' . $label . '.'];
+    }
+}
diff --git a/app/Support/Attendance/MonthOverview.php b/app/Support/Attendance/MonthOverview.php
new file mode 100644
index 0000000..e271b51
--- /dev/null
+++ b/app/Support/Attendance/MonthOverview.php
@@ -0,0 +1,83 @@
+<?php
+
+namespace App\Support\Attendance;
+
+use App\Models\Attendance;
+use App\Models\Client;
+use Carbon\Carbon;
+use Carbon\CarbonInterface;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Every client's month on one screen: plan, guards posted, shortage, and
+ * attendance totals. Same numbers as MonthSheet, worked out in a few queries.
+ */
+class MonthOverview
+{
+    /**
+     * @param  Collection<int, Client>  $clients
+     * @return Collection<int, array>
+     */
+    public static function rows(Collection $clients, CarbonInterface|string|null $month): Collection
+    {
+        $start = ShiftPlans::monthStart($month);
+        $end = $start->copy()->endOfMonth()->startOfDay();
+        $today = Carbon::today();
+        $lastCounted = $end->lt($today) ? $end : $today;
+        $elapsed = $lastCounted->lt($start) ? 0 : (int) $start->diffInDays($lastCounted) + 1;
+
+        $ids = $clients->pluck('id')->map(fn ($id) => (int) $id)->all();
+        $plans = ShiftPlans::forMonthMany($ids, $start);
+        $posted = Roster::shiftCounts($ids);
+
+        $counts = [];
+        $cover = [];
+        if ($ids) {
+            $base = DB::table('attendances')->whereIn('client_id', $ids)
+                ->whereBetween('work_date', [$start->toDateString(), $end->toDateString()]);
+
+            foreach ((clone $base)->selectRaw('client_id, status, COUNT(*) as n')->groupBy('client_id', 'status')->get() as $r) {
+                $counts[(int) $r->client_id][$r->status] = (int) $r->n;
+            }
+            foreach ((clone $base)->where('status', Attendance::PRESENT)->where('work_date', '<=', $lastCounted->toDateString())
+                ->selectRaw('client_id, work_date, shift, COUNT(*) as n')->groupBy('client_id', 'work_date', 'shift')->get() as $r) {
+                $cover[(int) $r->client_id][substr((string) $r->work_date, 0, 10)][$r->shift] = (int) $r->n;
+            }
+        }
+
+        return $clients->map(function (Client $client) use ($plans, $posted, $counts, $cover, $start, $elapsed) {
+            $plan = $plans->get($client->id);
+            $dayReq = (int) ($plan->day_guards ?? 0);
+            $nightReq = (int) ($plan->night_guards ?? 0);
+            $p = $posted[$client->id] ?? ['day' => 0, 'night' => 0, 'rotate' => 0, 'unset' => 0];
+            $c = $counts[$client->id] ?? [];
+
+            $uncovered = 0;
+            for ($i = 0; $i < $elapsed; $i++) {
+                $date = $start->copy()->addDays($i)->toDateString();
+                $uncovered += max(0, $dayReq - ($cover[$client->id][$date]['day'] ?? 0))
+                    + max(0, $nightReq - ($cover[$client->id][$date]['night'] ?? 0));
+            }
+
+            return [
+                'client' => $client,
+                'plan' => $plan,
+                'required_day' => $dayReq,
+                'required_night' => $nightReq,
+                'required' => $dayReq + $nightReq,
+                'posted' => array_sum($p),
+                'posted_by_shift' => $p,
+                'shortage' => Roster::shortage($dayReq, $nightReq, $p),
+                'worked' => $c[Attendance::PRESENT] ?? 0,
+                'paid' => collect(Attendance::PAID)->sum(fn ($s) => $c[$s] ?? 0),
+                'absent' => $c[Attendance::ABSENT] ?? 0,
+                'pending' => $c[Attendance::PENDING] ?? 0,
+                'required_guard_days' => ($dayReq + $nightReq) * $elapsed,
+                'uncovered_guard_days' => $plan ? $uncovered : null,
+                'has_qr' => (bool) $client->attendance_token,
+                'has_site' => $client->latitude !== null && $client->longitude !== null,
+            ];
+        })->values();
+    }
+}
diff --git a/app/Support/Attendance/MonthSheet.php b/app/Support/Attendance/MonthSheet.php
new file mode 100644
index 0000000..f644182
--- /dev/null
+++ b/app/Support/Attendance/MonthSheet.php
@@ -0,0 +1,154 @@
+<?php
+
+namespace App\Support\Attendance;
+
+use App\Models\Attendance;
+use App\Models\Client;
+use App\Models\ClientShiftPlan;
+use App\Models\employee;
+use Carbon\Carbon;
+use Carbon\CarbonInterface;
+use Illuminate\Support\Collection;
+
+/**
+ * One client's month, laid out like the Excel time sheet: a row per guard, a
+ * column per day, plus totals and day-by-day cover against the shift plan.
+ *
+ * Differences from the spreadsheet, on purpose:
+ *  - Absent counts only days marked absent. The sheet used "31 - present", which
+ *    made a new recruit's days before joining (the "-" cells) count as absent.
+ *  - OFF / SICK / PASS are kept apart from present but still count as paid days
+ *    (the sheet's legend gives each of them 1).
+ *  - Scans held for review ("?") count for nothing until operations approve them.
+ */
+class MonthSheet
+{
+    public Carbon $month;
+    public ?ClientShiftPlan $plan;
+    /** @var array<int, array{date: Carbon, day: int, weekday: string, future: bool}> */
+    public array $days = [];
+    /** @var array<int, array> */
+    public array $rows = [];
+    /** @var array<int, array{day: int, night: int}> present guards per date and shift */
+    public array $cover = [];
+    public array $totals = [];
+
+    public function __construct(public Client $client, CarbonInterface|string|null $month)
+    {
+        $this->month = ShiftPlans::monthStart($month);
+        $this->plan = ShiftPlans::forMonth($client->id, $this->month);
+        $this->build();
+    }
+
+    private function build(): void
+    {
+        $end = $this->month->copy()->endOfMonth()->startOfDay();
+        $today = Carbon::today();
+        for ($d = $this->month->copy(); $d->lte($end); $d->addDay()) {
+            $this->days[$d->day] = ['date' => $d->copy(), 'day' => $d->day, 'weekday' => $d->format('D'), 'future' => $d->gt($today)];
+            $this->cover[$d->day] = ['day' => 0, 'night' => 0];
+        }
+
+        $records = Attendance::where('client_id', $this->client->id)
+            ->whereBetween('work_date', [$this->month->toDateString(), $end->toDateString()])
+            ->get()
+            ->groupBy('employee_id');
+
+        // Guards posted now, plus anyone with records this month who has since moved on.
+        $guards = Roster::guards($this->client)->keyBy('id');
+        $former = $records->keys()->diff($guards->keys())->all();
+        if ($former) {
+            foreach (employee::whereIn('id', $former)->orderBy('name')->get(['id', 'name', 'phone_number', 'location', 'client_id', 'status']) as $e) {
+                $e->attendance_shift = null;
+                $e->former = true;
+                $guards[$e->id] = $e;
+            }
+        }
+
+        $elapsed = collect($this->days)->reject(fn ($d) => $d['future'])->count();
+        $sum = ['worked' => 0, 'paid' => 0, 'absent' => 0, 'pending' => 0, 'unmarked' => 0];
+
+        foreach ($guards as $guard) {
+            /** @var Collection $mine */
+            $mine = $records->get($guard->id, collect());
+            $cells = [];
+            foreach ($mine as $r) {
+                $cells[$r->work_date->day][$r->shift] = $r;
+                if ($r->status === Attendance::PRESENT) {
+                    $this->cover[$r->work_date->day][$r->shift]++;
+                }
+            }
+
+            $row = [
+                'employee' => $guard,
+                'shift' => $guard->attendance_shift,
+                'former' => (bool) ($guard->former ?? false),
+                'cells' => $cells,
+                'worked' => $mine->where('status', Attendance::PRESENT)->count(),
+                'paid' => $mine->whereIn('status', Attendance::PAID)->count(),
+                'absent' => $mine->where('status', Attendance::ABSENT)->count(),
+                'pending' => $mine->where('status', Attendance::PENDING)->count(),
+            ];
+            $markedDays = collect($cells)->keys()->filter(fn ($day) => ! $this->days[$day]['future'])->count();
+            $row['unmarked'] = $row['former'] ? 0 : max(0, $elapsed - $markedDays);
+
+            foreach ($sum as $k => $_) {
+                $sum[$k] += $row[$k];
+            }
+            $this->rows[] = $row;
+        }
+
+        $dayReq = (int) ($this->plan->day_guards ?? 0);
+        $nightReq = (int) ($this->plan->night_guards ?? 0);
+        $shortfall = 0;
+        foreach ($this->days as $n => $d) {
+            if (! $d['future']) {
+                $shortfall += max(0, $dayReq - $this->cover[$n]['day']) + max(0, $nightReq - $this->cover[$n]['night']);
+            }
+        }
+
+        $posted = ['day' => 0, 'night' => 0, 'rotate' => 0, 'unset' => 0];
+        foreach ($this->rows as $row) {
+            if (! $row['former']) {
+                $posted[$row['shift'] && isset(Roster::SHIFTS[$row['shift']]) ? $row['shift'] : 'unset']++;
+            }
+        }
+        $postedTotal = array_sum($posted);
+
+        $this->totals = $sum + [
+            'required' => $dayReq + $nightReq,
+            'required_day' => $dayReq,
+            'required_night' => $nightReq,
+            'posted' => $postedTotal,
+            'posted_by_shift' => $posted,
+            // "TOTAL SHORTAGES" on the Excel sheet: guards the plan needs that are not posted.
+            'shortage' => Roster::shortage($dayReq, $nightReq, $posted),
+            'elapsed_days' => $elapsed,
+            'required_guard_days' => ($dayReq + $nightReq) * $elapsed,
+            // Shift slots nobody was present for, so far this month (what an ABSENT DEDUCTION would bill).
+            'uncovered_guard_days' => $shortfall,
+        ];
+    }
+
+    /** Grid code for one guard on one day: "P", "A", "OFF", "?", "P/P" for a double shift, "" when unmarked. */
+    public static function code(array $cell): string
+    {
+        return collect(['day', 'night'])
+            ->filter(fn ($s) => isset($cell[$s]))
+            ->map(fn ($s) => Attendance::CODES[$cell[$s]->status] ?? '?')
+            ->implode('/');
+    }
+
+    /** CSS class for a cell, from the "worst" status in it. */
+    public static function css(array $cell): string
+    {
+        $statuses = collect($cell)->pluck('status');
+        foreach ([Attendance::PENDING => 'att-pending', Attendance::ABSENT => 'att-absent', Attendance::PRESENT => 'att-present'] as $s => $css) {
+            if ($statuses->contains($s)) {
+                return $css;
+            }
+        }
+
+        return $statuses->isEmpty() ? '' : 'att-leave';
+    }
+}
diff --git a/app/Support/Attendance/Roster.php b/app/Support/Attendance/Roster.php
new file mode 100644
index 0000000..d4c6218
--- /dev/null
+++ b/app/Support/Attendance/Roster.php
@@ -0,0 +1,156 @@
+<?php
+
+namespace App\Support\Attendance;
+
+use App\Models\Client;
+use App\Models\employee;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Who is posted where, on which shift, and which clients a user may manage.
+ *
+ * A guard is posted to the client in employees.client_id: the link every other
+ * ISSOBS screen uses, and the one "Re-assign guard" changes. (client_employee rows
+ * are not removed on re-assignment, so they cannot be trusted as postings.)
+ * The guard's shift at a client is kept on client_employee.shift; the row is
+ * created the first time a shift is set, and only read while the guard is
+ * still posted to that client.
+ */
+class Roster
+{
+    public const ACTIVE_STATUSES = ['Active', 'Re-Instate'];
+    public const SHIFTS = ['day' => 'Day', 'night' => 'Night', 'rotate' => 'Rotate'];
+
+    /** Roles that see every client (same as the client list). */
+    public const HEAD_OFFICE_ROLES = ['Invoice', 'Finance Manager', 'Director'];
+
+    /**
+     * Active guards posted to a client, each with ->attendance_shift (day|night|rotate|null).
+     *
+     * @return Collection<int, employee>
+     */
+    public static function guards(Client $client): Collection
+    {
+        $guards = employee::query()
+            ->whereIn('status', self::ACTIVE_STATUSES)
+            ->where('client_id', $client->id)
+            ->orderBy('name')
+            ->get(['id', 'name', 'phone_number', 'location', 'client_id', 'status', 'attendance_pin', 'attendance_device']);
+
+        $shifts = self::shiftMap([$client->id], $guards->pluck('id')->all());
+        $guards->each(fn ($e) => $e->attendance_shift = $shifts[$client->id][$e->id] ?? null);
+
+        return $guards;
+    }
+
+    public static function isPosted(employee $employee, Client $client): bool
+    {
+        return (int) $employee->client_id === (int) $client->id;
+    }
+
+    public static function shiftOf(employee $employee, Client $client): ?string
+    {
+        return DB::table('client_employee')->where('client_id', $client->id)->where('employee_id', $employee->id)
+            ->whereNotNull('shift')->orderByDesc('id')->value('shift');
+    }
+
+    /** [client_id => [employee_id => shift]] from client_employee (latest row wins). */
+    private static function shiftMap(array $clientIds, ?array $employeeIds = null): array
+    {
+        $q = DB::table('client_employee')->whereIn('client_id', $clientIds ?: [0])->whereNotNull('shift');
+        if ($employeeIds !== null) {
+            $q->whereIn('employee_id', $employeeIds ?: [0]);
+        }
+        $map = [];
+        foreach ($q->orderBy('id')->get(['client_id', 'employee_id', 'shift']) as $r) {
+            $map[(int) $r->client_id][(int) $r->employee_id] = $r->shift;
+        }
+
+        return $map;
+    }
+
+    public static function setShift(Client $client, employee $employee, ?string $shift): void
+    {
+        $shift = array_key_exists((string) $shift, self::SHIFTS) ? $shift : null;
+        $row = DB::table('client_employee')->where('client_id', $client->id)->where('employee_id', $employee->id);
+
+        if ($row->exists()) {
+            $row->update(['shift' => $shift, 'updated_at' => now()]);
+        } else {
+            DB::table('client_employee')->insert([
+                'client_id' => $client->id, 'employee_id' => $employee->id, 'location' => $employee->location,
+                'shift' => $shift, 'created_at' => now(), 'updated_at' => now(),
+            ]);
+        }
+    }
+
+    /**
+     * Guards on each shift for many clients: [client_id => ['day' => n, 'night' => n, 'rotate' => n, 'unset' => n]].
+     */
+    public static function shiftCounts(array $clientIds): array
+    {
+        if (! $clientIds) {
+            return [];
+        }
+
+        $shifts = self::shiftMap($clientIds);
+        $out = [];
+        $guards = employee::whereIn('status', self::ACTIVE_STATUSES)->whereIn('client_id', $clientIds)->get(['id', 'client_id']);
+        foreach ($guards as $e) {
+            $c = (int) $e->client_id;
+            $shift = $shifts[$c][(int) $e->id] ?? null;
+            $out[$c] ??= ['day' => 0, 'night' => 0, 'rotate' => 0, 'unset' => 0];
+            $out[$c][isset(self::SHIFTS[$shift]) ? $shift : 'unset']++;
+        }
+
+        return $out;
+    }
+
+    /**
+     * Guards the plan needs that are not posted ("TOTAL SHORTAGES" on the old sheet), worked out per
+     * shift: 3 day guards do not cover a missing night guard. Rotating guards, and guards with no
+     * shift set yet, fill whichever shift is short.
+     *
+     * @param  array{day:int, night:int, rotate:int, unset:int}  $posted
+     */
+    public static function shortage(int $dayRequired, int $nightRequired, array $posted): int
+    {
+        $short = max(0, $dayRequired - ($posted['day'] ?? 0)) + max(0, $nightRequired - ($posted['night'] ?? 0));
+
+        return max(0, $short - ($posted['rotate'] ?? 0) - ($posted['unset'] ?? 0));
+    }
+
+    /** Active, approved clients this user may take attendance for. */
+    public static function clientsFor(User $user): Builder
+    {
+        $q = Client::query()
+            ->whereRaw('LOWER(status) = ?', ['active'])
+            ->where('ho_status', 'approved');
+
+        if (self::seesAllClients($user)) {
+            return $q;
+        }
+        if (! $user->field_id) {
+            return $q->whereRaw('1 = 0');
+        }
+
+        // Tema staff also look after field 7 (same rule as client registration).
+        $fields = (int) $user->field_id === 3 ? [3, 7] : [(int) $user->field_id];
+
+        return $q->whereIn('field_id', $fields);
+    }
+
+    public static function seesAllClients(User $user): bool
+    {
+        return $user->hasRole(self::HEAD_OFFICE_ROLES)
+            || ($user->hasRole(['Manager']) && $user->hasPermission('HR'));
+    }
+
+    public static function canManage(User $user, Client $client): bool
+    {
+        return self::clientsFor($user)->whereKey($client->id)->exists();
+    }
+}
diff --git a/app/Support/Attendance/ScanRecorder.php b/app/Support/Attendance/ScanRecorder.php
new file mode 100644
index 0000000..8f38e4e
--- /dev/null
+++ b/app/Support/Attendance/ScanRecorder.php
@@ -0,0 +1,212 @@
+<?php
+
+namespace App\Support\Attendance;
+
+use App\Models\Attendance;
+use App\Models\Client;
+use App\Models\employee;
+use Carbon\Carbon;
+use Carbon\CarbonInterface;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\RateLimiter;
+
+/**
+ * A guard scanned the QR poster at a client's site and entered FWSS number + PIN.
+ *
+ * The QR proves which site's poster was scanned, not who scanned it or where
+ * they are standing, so the scan is checked against what we know:
+ *
+ *  - PIN            proves who (5 wrong tries lock that employee number for 15 minutes)
+ *  - roster         is the guard posted to this client?
+ *  - shift          does the time fit the guard's own shift?
+ *  - GPS            is the phone within the site radius? (a photo of the poster scanned at home fails here)
+ *  - phone          is it the guard's usual phone, and not one already used by another guard this shift?
+ *
+ * A scan that fails any check is still saved, as "pending" (shown "?" in the
+ * grid), and waits in the review queue. It never counts as present until
+ * operations approve it, and the guard is never simply turned away.
+ */
+class ScanRecorder
+{
+    public const MAX_PIN_TRIES = 5;
+    public const LOCK_SECONDS = 900;
+
+    /**
+     * @param  array{employee_number?:string, pin?:string, latitude?:mixed, longitude?:mixed, accuracy?:mixed, device_id?:string}  $input
+     * @return array{ok: bool, status?: string, message: string, attendance?: Attendance}
+     */
+    public static function record(Client $client, array $input, ?CarbonInterface $at = null, ?string $ip = null): array
+    {
+        $at = Carbon::instance($at ?? now());
+        $id = self::employeeId($input['employee_number'] ?? null);
+        $wrong = ['ok' => false, 'message' => 'Employee number or PIN is wrong.'];
+
+        if (! $id) {
+            return ['ok' => false, 'message' => 'Enter your employee number, e.g. FWSS 245.'];
+        }
+
+        $lockKey = 'attendance-pin:' . $id;
+        if (RateLimiter::tooManyAttempts($lockKey, self::MAX_PIN_TRIES)) {
+            $minutes = (int) ceil(RateLimiter::availableIn($lockKey) / 60);
+
+            return ['ok' => false, 'message' => "Too many wrong PINs. Try again in {$minutes} minute(s) or call your supervisor."];
+        }
+
+        $guard = employee::find($id);
+        if (! $guard) {
+            RateLimiter::hit($lockKey, self::LOCK_SECONDS);
+
+            return $wrong;
+        }
+        if (! $guard->attendance_pin) {
+            return ['ok' => false, 'message' => 'You do not have an attendance PIN yet. Ask your supervisor or operations for one.'];
+        }
+        if (! Hash::check((string) ($input['pin'] ?? ''), $guard->attendance_pin)) {
+            RateLimiter::hit($lockKey, self::LOCK_SECONDS);
+
+            return $wrong;
+        }
+        RateLimiter::clear($lockKey);
+
+        if (! in_array($guard->status, Roster::ACTIVE_STATUSES, true)) {
+            return ['ok' => false, 'message' => 'Your employee record is not active. Please see operations.'];
+        }
+
+        $plan = ShiftPlans::forMonth($client->id, $at);
+        $posted = Roster::isPosted($guard, $client);
+        $ownShift = $posted ? Roster::shiftOf($guard, $client) : null;
+        $slot = ShiftClock::resolve($at, $plan, $ownShift);
+        $date = $slot['date']->toDateString();
+        $shift = $slot['shift'];
+
+        $existing = Attendance::where('employee_id', $guard->id)->where('work_date', $date)->where('shift', $shift)->first();
+        if ($existing) {
+            if ($existing->source === 'scan' && $existing->checked_in_at) {
+                return ['ok' => true, 'status' => $existing->status, 'attendance' => $existing,
+                    'message' => "You already signed in for the {$shift} shift of " . $slot['date']->format('D j M') . ' at ' . $existing->checked_in_at->format('H:i') . '.'];
+            }
+
+            return ['ok' => true, 'status' => $existing->status, 'attendance' => $existing,
+                'message' => 'Operations have already recorded you as ' . strtolower(Attendance::LABELS[$existing->status] ?? $existing->status) . " for this {$shift} shift."];
+        }
+
+        // ---- checks -------------------------------------------------------------------------
+        $flags = [];
+        $notes = [];
+
+        if (! $posted) {
+            $flags[] = 'Not on this client\'s roster';
+        }
+        if (! $slot['in_own_shift']) {
+            $flags[] = "Signed in for the {$shift} shift but is rostered on " . ($ownShift ?: 'another') . ' shift';
+        }
+        if ($slot['late_minutes'] > ShiftClock::LATE_AFTER_MINUTES) {
+            $notes[] = 'Late by ' . self::duration($slot['late_minutes']);
+        }
+
+        $lat = self::coord($input['latitude'] ?? null, 90);
+        $lng = self::coord($input['longitude'] ?? null, 180);
+        $accuracy = isset($input['accuracy']) && is_numeric($input['accuracy']) ? (int) round((float) $input['accuracy']) : null;
+        $distance = null;
+
+        if ($lat === null || $lng === null) {
+            $flags[] = 'Phone did not share its location';
+        } elseif ($client->latitude !== null && $client->longitude !== null) {
+            $distance = (int) round(Geo::metres((float) $client->latitude, (float) $client->longitude, $lat, $lng));
+            // Allow for the phone's own uncertainty, up to 100 m of it.
+            $allowed = (int) ($client->attendance_radius_m ?: 200) + min($accuracy ?? 0, 100);
+            if ($distance > $allowed) {
+                $flags[] = 'Scanned ' . self::metres($distance) . ' from the site (allowed ' . self::metres($allowed) . ')';
+            }
+        } else {
+            $notes[] = 'Site location not set, distance not checked';
+        }
+
+        $device = self::deviceId($input['device_id'] ?? null);
+        if (! $device) {
+            $flags[] = 'Phone could not be identified';
+        } else {
+            $sharedWith = Attendance::where('device_id', $device)->where('work_date', $date)->where('shift', $shift)
+                ->where('employee_id', '!=', $guard->id)->with('employee:id,name')->first();
+            if ($sharedWith) {
+                $flags[] = 'Same phone already signed in ' . ($sharedWith->employee->name ?? 'another guard') . ' (FWSS ' . $sharedWith->employee_id . ') this shift';
+            }
+
+            $owner = employee::where('attendance_device', $device)->where('id', '!=', $guard->id)->first(['id', 'name']);
+            if ($guard->attendance_device && $guard->attendance_device !== $device) {
+                $flags[] = 'Different phone from the one this guard normally uses';
+            } elseif ($owner) {
+                $flags[] = 'Phone belongs to ' . $owner->name . ' (FWSS ' . $owner->id . ')';
+            } elseif (! $guard->attendance_device) {
+                // First scan: this phone becomes the guard's phone.
+                $guard->forceFill(['attendance_device' => $device])->saveQuietly();
+                $notes[] = 'Phone registered for this guard';
+            }
+        }
+
+        try {
+            $attendance = Attendance::create([
+                'client_id' => $client->id,
+                'employee_id' => $guard->id,
+                'work_date' => $date,
+                'shift' => $shift,
+                'status' => $flags ? Attendance::PENDING : Attendance::PRESENT,
+                'source' => 'scan',
+                'checked_in_at' => $at,
+                'latitude' => $lat,
+                'longitude' => $lng,
+                'accuracy_m' => $accuracy,
+                'distance_m' => $distance,
+                'device_id' => $device,
+                'ip' => $ip,
+                'flags' => $flags ?: null,
+                'note' => $notes ? implode('; ', $notes) : null,
+            ]);
+        } catch (UniqueConstraintViolationException) {
+            // The same guard pressed "Sign in" twice at once: the first one won.
+            return ['ok' => true, 'status' => Attendance::PRESENT, 'message' => "You are already signed in for the {$shift} shift."];
+        }
+
+        $first = trim(explode(' ', trim((string) $guard->name))[0] ?? '');
+        $when = ucfirst($shift) . ' shift, ' . $slot['date']->format('D j M');
+
+        return $flags
+            ? ['ok' => true, 'status' => Attendance::PENDING, 'attendance' => $attendance,
+                'message' => "Thank you {$first}. Your sign-in ({$when}, {$at->format('H:i')}) was received and will be checked by operations: " . implode('; ', $flags) . '.']
+            : ['ok' => true, 'status' => Attendance::PRESENT, 'attendance' => $attendance,
+                'message' => "Thank you {$first}. You are signed in: {$when}, {$at->format('H:i')}."];
+    }
+
+    /** "FWSS 45", "fwss45", "45" -> 45 (same rule as the employee import). */
+    public static function employeeId(?string $value): ?int
+    {
+        if ($value === null || ! preg_match('/^\s*(?:FWSS\s*)?(\d+)\s*$/i', $value, $m)) {
+            return null;
+        }
+
+        return (int) $m[1] ?: null;
+    }
+
+    private static function coord(mixed $v, int $max): ?float
+    {
+        return is_numeric($v) && abs((float) $v) <= $max ? round((float) $v, 7) : null;
+    }
+
+    private static function deviceId(?string $v): ?string
+    {
+        $v = trim((string) $v);
+
+        return preg_match('/^[A-Za-z0-9-]{16,64}$/', $v) ? $v : null;
+    }
+
+    private static function metres(int $m): string
+    {
+        return $m >= 1000 ? round($m / 1000, 1) . ' km' : $m . ' m';
+    }
+
+    private static function duration(int $minutes): string
+    {
+        return $minutes >= 60 ? intdiv($minutes, 60) . 'h ' . str_pad((string) ($minutes % 60), 2, '0', STR_PAD_LEFT) . 'm' : $minutes . ' min';
+    }
+}
diff --git a/app/Support/Attendance/ShiftClock.php b/app/Support/Attendance/ShiftClock.php
new file mode 100644
index 0000000..250f573
--- /dev/null
+++ b/app/Support/Attendance/ShiftClock.php
@@ -0,0 +1,93 @@
+<?php
+
+namespace App\Support\Attendance;
+
+use App\Models\ClientShiftPlan;
+use Carbon\Carbon;
+use Carbon\CarbonInterface;
+
+/**
+ * Works out which shift (and which date) a scan belongs to.
+ *
+ *  - A night shift that runs past midnight belongs to the date it started on:
+ *    with a 18:00-06:00 night, a scan at 02:00 on the 5th counts for the night of the 4th.
+ *  - Guards arrive early, so a scan up to EARLY_MINUTES before their own shift
+ *    starts counts for that shift (05:15 for a 06:00 day shift is the day shift).
+ */
+class ShiftClock
+{
+    public const EARLY_MINUTES = 120;
+    public const LATE_AFTER_MINUTES = 60;
+
+    /**
+     * @param  string|null  $preferred  the guard's own shift at this client: day | night | rotate | null
+     * @return array{date: Carbon, shift: string, in_own_shift: bool, late_minutes: int}
+     */
+    public static function resolve(CarbonInterface $at, ?ClientShiftPlan $plan, ?string $preferred = null): array
+    {
+        $times = self::times($plan);
+        $at = Carbon::instance($at);
+
+        // 1. The guard's own shift, allowing for an early arrival.
+        if (in_array($preferred, ['day', 'night'], true)) {
+            $own = self::windowFor($at, $preferred, $times, self::EARLY_MINUTES);
+            if ($own) {
+                return $own + ['in_own_shift' => true];
+            }
+        }
+
+        // 2. Otherwise whichever shift the clock says it is.
+        $hit = self::windowFor($at, 'day', $times, 0) ?? self::windowFor($at, 'night', $times, 0);
+        if (! $hit) {
+            // Gap between shifts (e.g. day 07:00-15:00, night 19:00-05:00): take the next one to start.
+            $hit = self::windowFor($at, 'day', $times, self::EARLY_MINUTES)
+                ?? self::windowFor($at, 'night', $times, self::EARLY_MINUTES)
+                ?? ['date' => $at->copy()->startOfDay(), 'shift' => 'day', 'late_minutes' => 0];
+        }
+
+        $hit['in_own_shift'] = ! in_array($preferred, ['day', 'night'], true) || $hit['shift'] === $preferred;
+
+        return $hit;
+    }
+
+    /** @return array{day_start:string,day_end:string,night_start:string,night_end:string} */
+    public static function times(?ClientShiftPlan $plan): array
+    {
+        $t = ShiftPlans::DEFAULT_TIMES;
+        if ($plan) {
+            foreach ($t as $k => $default) {
+                $t[$k] = ShiftPlans::time($plan->{$k}, $default);
+            }
+        }
+
+        return $t;
+    }
+
+    /**
+     * If $at falls in a $shift that started on $at's date or the date before (opening
+     * $early minutes before the start), return that shift's date and how late $at is.
+     */
+    private static function windowFor(Carbon $at, string $shift, array $times, int $early): ?array
+    {
+        [$sh, $sm] = array_map('intval', explode(':', $times[$shift . '_start']));
+        [$eh, $em] = array_map('intval', explode(':', $times[$shift . '_end']));
+
+        foreach ([0, 1] as $daysBack) {
+            $date = $at->copy()->startOfDay()->subDays($daysBack);
+            $start = $date->copy()->setTime($sh, $sm);
+            $end = $date->copy()->setTime($eh, $em);
+            if ($end->lessThanOrEqualTo($start)) {
+                $end->addDay();                       // crosses midnight
+            }
+            if ($at->greaterThanOrEqualTo($start->copy()->subMinutes($early)) && $at->lessThan($end)) {
+                return [
+                    'date' => $date,
+                    'shift' => $shift,
+                    'late_minutes' => max(0, (int) $start->diffInMinutes($at, false)),
+                ];
+            }
+        }
+
+        return null;
+    }
+}
diff --git a/app/Support/Attendance/ShiftPlans.php b/app/Support/Attendance/ShiftPlans.php
new file mode 100644
index 0000000..f5acde0
--- /dev/null

diff --git a/app/Support/PeriodSeries.php b/app/Support/PeriodSeries.php
new file mode 100644
index 0000000..82a5535
--- /dev/null
+++ b/app/Support/PeriodSeries.php
@@ -0,0 +1,80 @@
+<?php
+
+namespace App\Support;
+
+use Carbon\Carbon;
+use Illuminate\Http\Request;
+
+/**
+ * Shared period handling for the bank screens: read ?from=&to=&group= from the request,
+ * and fold daily rows into day / week / month / year buckets. Done in PHP so it behaves
+ * the same on any database.
+ */
+final class PeriodSeries
+{
+    public const GROUPS = ['day', 'week', 'month', 'year'];
+
+    /** @return array{0: Carbon, 1: Carbon, 2: string} [from (00:00), to (23:59), group] */
+    public static function window(Request $request, string $defaultGroup = 'day'): array
+    {
+        $group = in_array($request->input('group'), self::GROUPS, true) ? $request->input('group') : $defaultGroup;
+
+        $parse = function ($value, Carbon $fallback): Carbon {
+            try {
+                return is_string($value) && $value !== '' ? Carbon::parse($value) : $fallback;
+            } catch (\Throwable) {
+                return $fallback;
+            }
+        };
+
+        $from = $parse($request->input('from'), now()->startOfMonth())->startOfDay();
+        $to = $parse($request->input('to'), now())->endOfDay();
+        if ($from->gt($to)) {
+            [$from, $to] = [$to->copy()->startOfDay(), $from->copy()->endOfDay()];
+        }
+
+        return [$from, $to, $group];
+    }
+
+    public static function key(Carbon $d, string $group): string
+    {
+        return match ($group) {
+            'week' => $d->copy()->startOfWeek()->format('Y-m-d'),
+            'month' => $d->format('Y-m'),
+            'year' => $d->format('Y'),
+            default => $d->format('Y-m-d'),
+        };
+    }
+
+    public static function label(Carbon $d, string $group): string
+    {
+        return match ($group) {
+            'week' => $d->copy()->startOfWeek()->format('d M Y'),
+            'month' => $d->format('M Y'),
+            'year' => $d->format('Y'),
+            default => $d->format('d M Y'),
+        };
+    }
+
+    /**
+     * @param iterable $rows  objects with `d` (date), optional `c` (entry count) and numeric columns
+     * @param array<string,string> $sums  output name => column on the row, e.g. ['in' => 'i', 'out' => 'o']
+     * @return array<int, array>  [['label'=>..., 'count'=>..., <sums>...], ...] oldest first
+     */
+    public static function build(iterable $rows, string $group, array $sums): array
+    {
+        $out = [];
+        foreach ($rows as $r) {
+            $d = Carbon::parse($r->d);
+            $k = self::key($d, $group);
+            $out[$k] ??= ['label' => self::label($d, $group), 'count' => 0] + array_fill_keys(array_keys($sums), 0.0);
+            $out[$k]['count'] += (int) ($r->c ?? 0);
+            foreach ($sums as $name => $column) {
+                $out[$k][$name] += (float) $r->{$column};
+            }
+        }
+        ksort($out);
+
+        return array_values($out);
+    }
+}

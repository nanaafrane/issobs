+
+        document.getElementById('dpTable').addEventListener('change', e => { if (e.target.matches('.dp-pick, .dp-bank')) refresh(); });
+
+        // Select all = set every SHOWN row to the header's state (the old script flipped each box instead).
+        document.getElementById('dpAll').addEventListener('change', function () {
+            dpTable.rows({ search: 'applied' }).nodes().toArray().forEach(tr => tr.querySelector('.dp-pick').checked = this.checked);
+            refresh();
+        });
+
+        document.getElementById('dpApplyBank').addEventListener('click', () => {
+            const bank = document.getElementById('dpBulkBank').value;
+            if (!bank) return alert('Choose a bank first.');
+            picked().forEach(tr => tr.querySelector('.dp-bank').value = bank);
+        });
+
+        document.getElementById('dpForm').addEventListener('submit', function (e) {
+            const rows = picked();
+            const missing = rows.filter(tr => !tr.querySelector('.dp-bank').value);
+            allRows().forEach(tr => tr.querySelector('.dp-bank').classList.remove('dp-missing'));
+            if (missing.length) {
+                e.preventDefault();
+                missing.forEach(tr => tr.querySelector('.dp-bank').classList.add('dp-missing'));
+                return alert('Choose a bank for every ticked collection (' + missing.length + ' missing).');
+            }
+            const total = rows.reduce((s, r) => s + Number(r.querySelector('.dp-pick').dataset.amount), 0);
+            if (!confirm('Deposit ' + rows.length + ' collection(s) totalling ' + dpMoney(total) + '?')) return e.preventDefault();
+
+            // Submit only what is ticked, keyed by collection id so every bank stays with its own row.
+            const box = document.getElementById('dpHidden');
+            box.innerHTML = '';
+            rows.forEach(tr => {
+                const id = tr.dataset.id;
+                box.insertAdjacentHTML('beforeend',
+                    '<input type="hidden" name="collections[]" value="' + id + '">' +
+                    '<input type="hidden" name="bank_id[' + id + ']" value="' + tr.querySelector('.dp-bank').value + '">');
+            });
+        });
+        refresh();
+    </script>
+    @endif
+    @endsection
+
+</x-sales-dashboard>

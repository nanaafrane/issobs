diff --git a/app/Services/Banking/CashBook.php b/app/Services/Banking/CashBook.php
new file mode 100644
index 0000000..daf3e6f
--- /dev/null
+++ b/app/Services/Banking/CashBook.php
@@ -0,0 +1,197 @@
+<?php
+
+namespace App\Services\Banking;
+
+use App\Models\AccountPayment;
+use App\Models\Bank;
+use App\Models\BankTransaction;
+use App\Models\Expense;
+use Carbon\Carbon;
+use Illuminate\Support\Collection;
+
+/**
+ * The analysed cash book: the Main Cash sheet (DATE | Payment details | CHEQ NO | PAYMENT |
+ * RECEIPT | BALANCE | one column per item) built from the ledger, so the month-end total per
+ * item is never typed or summed by hand.
+ *
+ * Every money-out line is spread over its items:
+ *  - a payment of approved expenses -> each expense's type (Fuel, Rent, Vehicle Repairs &
+ *    Maintenance…) and office, in proportion to the expense amounts;
+ *  - any other payment -> its payment category (Salaries & wages, Bank charges…);
+ *  - money moved to another of our accounts -> "Bank deposit / transfer out";
+ *  - creditor repayments -> "Loan repayment"; MoMo charges, adjustments -> their own item.
+ * Money coming back on a payment (cancelled, returned) is a negative on the same item.
+ * Other money in (funding, receipts, loans received) goes in RECEIPT only, as on the sheet.
+ *
+ * For "all accounts", moves between our own accounts are left out (they are not spending).
+ */
+class CashBook
+{
+    public const TRANSFER_OUT = 'Bank deposit / transfer out';
+
+    /**
+     * @param  Bank|null  $bank  null = every account
+     * @return array{bank: ?Bank, from: Carbon, to: Carbon, opening: ?float, closing: ?float, lines: Collection,
+     *               items: Collection, offices: Collection, matrix: array, receipts: float, payments: float, analysed: float}
+     */
+    public function analysis(?Bank $bank, Carbon $from, Carbon $to): array
+    {
+        $range = [$from->toDateString(), $to->toDateString()];
+        $opening = null;
+        if ($bank) {
+            $before = BankTransaction::where('bank_id', $bank->id)->where('entry_date', '<', $range[0])
+                ->selectRaw('COALESCE(SUM(credit),0) - COALESCE(SUM(debit),0) AS net')->value('net');
+            $opening = round((float) $bank->opening_balance + (float) $before, 2);
+        }
+
+        $ledger = BankTransaction::with('bank')
+            ->when($bank, fn ($q) => $q->where('bank_id', $bank->id))
+            ->when(! $bank, fn ($q) => $q->whereNotIn('channel', ['transfer_in', 'transfer_out']))
+            ->whereBetween('entry_date', $range)
+            ->orderBy('entry_date')->orderBy('id')->get();
+
+        $payments = AccountPayment::whereIn('id', $ledger->pluck('payment_id')->filter()->unique())->get()->keyBy('id');
+        $expenses = Expense::withTrashed()->with(['type', 'field'])->whereIn('payment_id', $payments->keys())->get()->groupBy('payment_id');
+
+        $running = $opening;
+        $lines = $ledger->map(function (BankTransaction $t) use (&$running, $payments, $expenses) {
+            $credit = round((float) $t->credit, 2);
+            $debit = round((float) $t->debit, 2);
+            if ($running !== null) {
+                $running = round($running + $credit - $debit, 2);
+            }
+            $payment = $t->payment_id ? $payments->get($t->payment_id) : null;
+
+            return [
+                'line' => $t,
+                'date' => $t->entry_date,
+                'details' => $t->narration,
+                'reference' => $payment?->reference,
+                'account' => $t->bank?->name,
+                'payment' => $debit,
+                'receipt' => $credit,
+                'balance' => $running,
+                'splits' => $this->splits($t, $payment, $payment ? $expenses->get($payment->id, collect()) : collect()),
+            ];
+        });
+
+        // Totals per item, and per item and office.
+        $items = [];
+        $matrix = [];
+        $offices = [];
+        foreach ($lines as $l) {
+            foreach ($l['splits'] as $s) {
+                $items[$s['item']] = round(($items[$s['item']] ?? 0) + $s['amount'], 2);
+                $office = $s['office'] ?? 'Head office / not set';
+                $offices[$office] = true;
+                $matrix[$s['item']][$office] = round(($matrix[$s['item']][$office] ?? 0) + $s['amount'], 2);
+            }
+        }
+        $items = collect($items)->filter(fn ($v) => abs($v) > 0.004)->sortDesc();
+        $officeList = collect(array_keys($offices))->sort(fn ($a, $b) => str_starts_with($a, 'Head office') <=> str_starts_with($b, 'Head office') ?: strcmp($a, $b))->values();
+
+        return [
+            'bank' => $bank,
+            'from' => $from,
+            'to' => $to,
+            'opening' => $opening,
+            'closing' => $running,
+            'lines' => $lines,
+            'items' => $items,
+            'offices' => $officeList,
+            'matrix' => $matrix,
+            'receipts' => round((float) $lines->sum('receipt'), 2),
+            'payments' => round((float) $lines->sum('payment'), 2),
+            'analysed' => round((float) $items->sum(), 2),
+        ];
+    }
+
+    /**
+     * How much of one ledger line is spending, on which item and office. Spending is positive
+     * (money out); money coming back on a payment is negative.
+     *
+     * @return array<int, array{item: string, office: ?string, amount: float}>
+     */
+    private function splits(BankTransaction $t, ?AccountPayment $payment, Collection $expenses): array
+    {
+        $spent = round((float) $t->debit - (float) $t->credit, 2);
+        if (abs($spent) < 0.005) {
+            return [];
+        }
+
+        if ($payment) {
+            $live = $expenses->filter(fn ($e) => (float) $e->amount > 0);
+            if ($live->isNotEmpty()) {
+                return $this->spread($spent, $live->map(fn ($e) => [
+                    'item' => $e->type?->name ?? 'Expenses (no type)',
+                    'office' => $e->field?->name,
+                    'weight' => (float) $e->amount,
+                ])->values()->all());
+            }
+
+            return [['item' => AccountPayment::CATEGORIES[$payment->category] ?? ucfirst((string) $payment->category), 'office' => null, 'amount' => $spent]];
+        }
+
+        if ($spent < 0) {
+            return [];   // money in that is not a refund: RECEIPT column only
+        }
+
+        $item = match ($t->channel) {
+            'transfer_out' => self::TRANSFER_OUT,
+            'loan_out' => 'Loan repayment',
+            'momo_charge' => 'MoMo Charges',
+            'adjustment' => 'Adjustments (short / correction)',
+            'expense' => 'Expenses (old entries)',
+            default => 'Other',
+        };
+
+        return [['item' => $item, 'office' => null, 'amount' => $spent]];
+    }
+
+    /** Split an amount over weighted parts, rounding so the parts add up to the amount exactly. */
+    private function spread(float $amount, array $parts): array
+    {
+        $total = array_sum(array_column($parts, 'weight'));
+        $out = [];
+        $left = $amount;
+        foreach ($parts as $i => $p) {
+            $share = $i === array_key_last($parts) ? round($left, 2) : round($amount * $p['weight'] / $total, 2);
+            $left = round($left - $share, 2);
+            $key = $p['item'] . '|' . $p['office'];
+            $out[$key] ??= ['item' => $p['item'], 'office' => $p['office'], 'amount' => 0.0];
+            $out[$key]['amount'] = round($out[$key]['amount'] + $share, 2);
+        }
+
+        return array_values($out);
+    }
+
+    /** Lines × items, laid out like the Main Cash sheet (for the Excel export). */
+    public function sheet(array $a): array
+    {
+        $items = $a['items']->keys()->all();
+        $title = $a['bank']?->name ?? 'All accounts';
+        $rows = [];
+        $rows[] = ['Name of Account: ' . strtoupper((string) config('app.name')) . ' — ' . strtoupper($title)];
+        $rows[] = ['', 'Period: ' . $a['from']->format('d M Y') . ' to ' . $a['to']->format('d M Y')];
+        $rows[] = [];
+        $rows[] = ['Currency:', 'GHC'];
+        $rows[] = array_merge(['DATE', 'Payment details', 'CHEQ NO:', 'PAYMENT', 'RECEIPT', 'BALANCE'], $a['bank'] ? [] : ['ACCOUNT'], array_map('strtoupper', $items));
+        if ($a['opening'] !== null) {
+            $rows[] = [$a['from']->format('d.m.y'), 'Opening balance', '', null, null, $a['opening']];
+        }
+        foreach ($a['lines'] as $l) {
+            $cells = [];
+            foreach ($l['splits'] as $s) {
+                $cells[$s['item']] = round(($cells[$s['item']] ?? 0) + $s['amount'], 2);
+            }
+            $rows[] = array_merge(
+                [$l['date']?->format('d.m.y'), $l['details'], $l['reference'], $l['payment'] ?: null, $l['receipt'] ?: null, $l['balance']],
+                $a['bank'] ? [] : [$l['account']],
+                array_map(fn ($i) => isset($cells[$i]) && abs($cells[$i]) > 0.004 ? $cells[$i] : null, $items)
+            );
+        }
+        $rows[] = array_merge(['', 'TOTAL', '', $a['payments'], $a['receipts'], $a['closing']], $a['bank'] ? [] : [''], array_values($a['items']->all()));
+
+        return $rows;
+    }
+}
diff --git a/app/Services/Fleet/FleetReports.php b/app/Services/Fleet/FleetReports.php
new file mode 100644
index 0000000..f27aba9
--- /dev/null
+++ b/app/Services/Fleet/FleetReports.php
@@ -0,0 +1,173 @@
+<?php
+
+namespace App\Services\Fleet;
+
+use App\Models\FuelEntry;
+use App\Models\MaintenanceType;
+use App\Models\Vehicle;
+use App\Models\VehicleMaintenance;
+use Carbon\Carbon;
+use Illuminate\Support\Collection;
+
+/**
+ * Fleet figures by the day the fuel was drawn / the work was done (not when it was paid —
+ * the cash book shows when money left an account).
+ *
+ *  vehicleSummary()  per vehicle for a period: litres, fuel cost, maintenance by type, total,
+ *                    km driven, km per litre, cost per km.
+ *  due()             renewals and services that have expired or fall due soon.
+ *
+ * Rejected entries are left out. Pending ones are counted (they are real fuel / work) and
+ * shown separately as "not yet approved".
+ */
+class FleetReports
+{
+    /**
+     * @param  array<int>|null  $fieldIds  null = every office
+     * @return array{rows: Collection, types: Collection, totals: array}
+     */
+    public function vehicleSummary(Carbon $from, Carbon $to, ?array $fieldIds = null): array
+    {
+        $range = [$from->toDateString(), $to->toDateString()];
+        $notRejected = fn ($q) => $q->where(fn ($w) => $w->whereNull('status_2')->orWhere('status_2', '!=', 'rejected'))
+            ->where(fn ($w) => $w->whereNull('status_3')->orWhere('status_3', '!=', 'rejected'));
+
+        $fuel = FuelEntry::whereBetween('entry_date', $range)->where($notRejected)
+            ->when($fieldIds !== null, fn ($q) => $q->whereIn('field_id', $fieldIds ?: [0]))
+            ->orderBy('entry_date')->orderBy('id')->get()->groupBy('vehicle_id');
+        $work = VehicleMaintenance::with('type')->whereBetween('service_date', $range)->where($notRejected)
+            ->when($fieldIds !== null, fn ($q) => $q->whereIn('field_id', $fieldIds ?: [0]))
+            ->get()->groupBy('vehicle_id');
+
+        $vehicleIds = $fuel->keys()->merge($work->keys())->unique();
+        $vehicles = Vehicle::with('field')->whereIn('id', $vehicleIds)
+            ->orWhere(fn ($q) => $q->where('status', 'active')->when($fieldIds !== null, fn ($w) => $w->whereIn('field_id', $fieldIds ?: [0])))
+            ->orderBy('reg_no')->get();
+
+        $types = collect();
+        $rows = $vehicles->map(function (Vehicle $v) use ($fuel, $work, &$types) {
+            $f = $fuel->get($v->id, collect());
+            $w = $work->get($v->id, collect());
+            $byType = $w->groupBy(fn ($m) => $m->type?->name ?? 'Other')->map(fn ($g) => round((float) $g->sum('amount'), 2));
+            $types = $types->merge($byType->keys());
+
+            $consumption = $this->consumption($f);
+            $fuelCost = round((float) $f->sum('amount'), 2);
+            $maint = round((float) $w->sum('amount'), 2);
+            $km = $consumption['km'] ?? $this->kmFromReadings($f->pluck('odometer')->merge($w->pluck('odometer')));
+
+            return [
+                'vehicle' => $v,
+                'fills' => $f->count(),
+                'litres' => round((float) $f->sum('litres'), 2),
+                'fuel' => $fuelCost,
+                'fuel_pending' => round((float) $f->filter(fn ($e) => ! $e->isFullyApproved())->sum('amount'), 2),
+                'maintenance' => $maint,
+                'by_type' => $byType,
+                'total' => round($fuelCost + $maint, 2),
+                'km' => $km,
+                'km_per_litre' => $consumption['km_per_litre'],
+                'cost_per_km' => $km ? round(($fuelCost + $maint) / $km, 2) : null,
+            ];
+        })->filter(fn ($r) => $r['total'] > 0 || $r['vehicle']->status === 'active')->values();
+
+        $types = $types->unique()->sort()->values();
+
+        return [
+            'rows' => $rows,
+            'types' => $types,
+            'totals' => [
+                'litres' => round($rows->sum('litres'), 2),
+                'fuel' => round($rows->sum('fuel'), 2),
+                'maintenance' => round($rows->sum('maintenance'), 2),
+                'total' => round($rows->sum('total'), 2),
+                'by_type' => $types->mapWithKeys(fn ($t) => [$t => round($rows->sum(fn ($r) => (float) ($r['by_type'][$t] ?? 0)), 2)]),
+            ],
+        ];
+    }
+
+    /**
+     * Full-tank method: km between the first and last reading in the period, over the litres put
+     * in AFTER the first reading (the first fill-up was used before it).
+     *
+     * @return array{km: ?int, km_per_litre: ?float}
+     */
+    public function consumption(Collection $fills): array
+    {
+        $read = $fills->filter(fn ($e) => $e->odometer !== null)->sortBy([['odometer', 'asc'], ['entry_date', 'asc']])->values();
+        if ($read->count() < 2) {
+            return ['km' => null, 'km_per_litre' => null];
+        }
+        $first = $read->first();
+        $last = $read->last();
+        $km = (int) $last->odometer - (int) $first->odometer;
+        $litres = (float) $fills->filter(fn ($e) => $e->id !== $first->id && $e->odometer !== null && $e->odometer > $first->odometer)->sum('litres');
+
+        return ['km' => $km > 0 ? $km : null, 'km_per_litre' => $km > 0 && $litres > 0 ? round($km / $litres, 2) : null];
+    }
+
+    private function kmFromReadings(Collection $readings): ?int
+    {
+        $r = $readings->filter()->map(fn ($v) => (int) $v);
+
+        return $r->count() >= 2 && $r->max() > $r->min() ? $r->max() - $r->min() : null;
+    }
+
+    /**
+     * For every active vehicle and every tracked maintenance type that the vehicle has had (and
+     * every document type — roadworthy / insurance — even if never recorded): when it is due.
+     *
+     * @param  array<int>|null  $fieldIds
+     * @return Collection<int, array{vehicle: Vehicle, type: MaintenanceType, last: ?VehicleMaintenance,
+     *                     due_date: ?Carbon, due_km: ?int, current_km: ?int, state: string, days: ?int}>
+     */
+    public function due(?array $fieldIds = null, int $soonDays = 30, ?int $vehicleId = null): Collection
+    {
+        $vehicles = Vehicle::with('field')->where('status', 'active')
+            ->when($fieldIds !== null, fn ($q) => $q->whereIn('field_id', $fieldIds ?: [0]))
+            ->when($vehicleId, fn ($q) => $q->whereKey($vehicleId))
+            ->orderBy('reg_no')->get();
+        if ($vehicles->isEmpty()) {
+            return collect();
+        }
+        $types = MaintenanceType::active()->get()->filter->isTracked()->keyBy('id');
+        $latest = VehicleMaintenance::whereIn('vehicle_id', $vehicles->pluck('id'))->whereIn('maintenance_type_id', $types->keys())
+            ->where(fn ($w) => $w->whereNull('status_2')->orWhere('status_2', '!=', 'rejected'))
+            ->where(fn ($w) => $w->whereNull('status_3')->orWhere('status_3', '!=', 'rejected'))
+            ->orderBy('service_date')->orderBy('id')->get()
+            ->groupBy(fn ($m) => $m->vehicle_id . ':' . $m->maintenance_type_id)->map->last();
+
+        $kmNow = FuelEntry::whereIn('vehicle_id', $vehicles->pluck('id'))->groupBy('vehicle_id')->selectRaw('vehicle_id, MAX(odometer) AS km')->pluck('km', 'vehicle_id');
+        $kmWork = VehicleMaintenance::whereIn('vehicle_id', $vehicles->pluck('id'))->groupBy('vehicle_id')->selectRaw('vehicle_id, MAX(odometer) AS km')->pluck('km', 'vehicle_id');
+        $today = now()->startOfDay();
+
+        $out = collect();
+        foreach ($vehicles as $v) {
+            $current = max((int) ($kmNow[$v->id] ?? 0), (int) ($kmWork[$v->id] ?? 0), (int) $v->opening_odometer) ?: null;
+            foreach ($types as $t) {
+                $last = $latest->get($v->id . ':' . $t->id);
+                if (! $last && ! $t->is_document) {
+                    continue;   // a service never done on this vehicle is not tracked until it is first recorded
+                }
+                $dueDate = $last?->valid_until
+                    ?? ($last && $t->repeat_months ? $last->service_date->copy()->addMonthsNoOverflow($t->repeat_months) : null);
+                $dueKm = $last?->next_due_km ?? ($last && $t->repeat_km && $last->odometer ? (int) $last->odometer + (int) $t->repeat_km : null);
+
+                $days = $dueDate ? (int) $today->diffInDays($dueDate, false) : null;
+                $kmLeft = $dueKm && $current ? $dueKm - $current : null;
+                $state = match (true) {
+                    ! $last => 'missing',
+                    ($days !== null && $days < 0) || ($kmLeft !== null && $kmLeft < 0) => 'overdue',
+                    ($days !== null && $days <= $soonDays) || ($kmLeft !== null && $kmLeft <= 500) => 'soon',
+                    default => 'ok',
+                };
+                $out->push(['vehicle' => $v, 'type' => $t, 'last' => $last, 'due_date' => $dueDate, 'due_km' => $dueKm,
+                    'current_km' => $current, 'km_left' => $kmLeft, 'state' => $state, 'days' => $days]);
+            }
+        }
+
+        $order = ['overdue' => 0, 'missing' => 1, 'soon' => 2, 'ok' => 3];
+
+        return $out->sortBy(fn ($r) => sprintf('%d-%08d-%s', $order[$r['state']], ($r['days'] ?? 99999999) + 50000, $r['vehicle']->reg_no))->values();
+    }
+}
diff --git a/app/Services/Fleet/FuelEntries.php b/app/Services/Fleet/FuelEntries.php
new file mode 100644
index 0000000..6c22277
--- /dev/null
+++ b/app/Services/Fleet/FuelEntries.php
@@ -0,0 +1,107 @@
+<?php
+
+namespace App\Services\Fleet;
+
+use App\Models\FuelEntry;
+use App\Models\Vehicle;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Validation\ValidationException;
+
+/**
+ * Saving a fill-up. Works out litres or price per litre from the other two, defaults the office,
+ * fuel type and driver from the vehicle, and refuses a km reading that goes backwards (it would
+ * spoil the km per litre figures).
+ */
+class FuelEntries
+{
+    public function create(array $data): FuelEntry
+    {
+        $entry = new FuelEntry();
+        $entry->fill($this->prepare($data));
+        $entry->user_1 = Auth::id();
+        $entry->status_1 = 'approved';   // the creator's own confirmation, as for overtime
+        $entry->date_1 = now();
+        $entry->save();
+
+        return $entry;
+    }
+
+    public function update(FuelEntry $entry, array $data): FuelEntry
+    {
+        if ($entry->isLockedForPay()) {
+            throw ValidationException::withMessages(['amount' => 'This fuel is on pay-out #' . $entry->payout_id . ': cancel the pay-out first.']);
+        }
+        $entry->fill($this->prepare($data, $entry->id));
+        $entry->save();
+
+        return $entry;
+    }
+
+    private function prepare(array $data, ?int $exceptId = null): array
+    {
+        $vehicle = Vehicle::findOrFail((int) $data['vehicle_id']);
+        $amount = round((float) ($data['amount'] ?? 0), 2);
+        $litres = isset($data['litres']) && $data['litres'] !== '' ? round((float) $data['litres'], 2) : null;
+        $price = isset($data['price_per_litre']) && $data['price_per_litre'] !== '' ? round((float) $data['price_per_litre'], 3) : null;
+
+        if ($amount <= 0) {
+            throw ValidationException::withMessages(['amount' => 'Enter the fuel issued (GH₵).']);
+        }
+        if (! $litres && ! $price) {
+            throw ValidationException::withMessages(['litres' => 'Enter the litres or the price per litre.']);
+        }
+        $litres ??= round($amount / $price, 2);
+        $price ??= round($amount / $litres, 3);
+        if (abs($litres * $price - $amount) > max(1.0, $amount * 0.02)) {
+            throw ValidationException::withMessages(['litres' => sprintf('%.2f litres at GH₵ %.3f is GH₵ %.2f, not GH₵ %.2f. Check the figures.', $litres, $price, $litres * $price, $amount)]);
+        }
+
+        $odometer = isset($data['odometer']) && $data['odometer'] !== '' ? (int) $data['odometer'] : null;
+        if ($odometer !== null) {
+            $this->checkOdometer($vehicle, $data['entry_date'], $odometer, $exceptId);
+        }
+
+        return [
+            'entry_date' => $data['entry_date'],
+            'vehicle_id' => $vehicle->id,
+            'field_id' => $data['field_id'] ?? $vehicle->field_id,
+            'driver_employee_id' => $data['driver_employee_id'] ?? ($data['driver_name'] ?? null ? null : $vehicle->driver_employee_id),
+            'driver_name' => $this->clean($data['driver_name'] ?? null, 120) ?? ($data['driver_employee_id'] ?? null ? null : $vehicle->driver_name),
+            'purpose' => $this->clean($data['purpose'] ?? null, 150),
+            'fuel_type' => $data['fuel_type'] ?? $vehicle->fuel_type,
+            'litres' => $litres,
+            'price_per_litre' => $price,
+            'amount_requested' => isset($data['amount_requested']) && $data['amount_requested'] !== '' ? round((float) $data['amount_requested'], 2) : $amount,
+            'amount' => $amount,
+            'station' => $this->clean(isset($data['station']) ? strtoupper((string) $data['station']) : null, 100),
+            'odometer' => $odometer,
+            'receipt_no' => $this->clean($data['receipt_no'] ?? null, 60),
+            'notes' => $this->clean($data['notes'] ?? null, 500),
+        ];
+    }
+
+    /** A reading must not be below one taken on an earlier day, nor above one taken on a later day. */
+    private function checkOdometer(Vehicle $vehicle, string $date, int $km, ?int $exceptId): void
+    {
+        $base = FuelEntry::where('vehicle_id', $vehicle->id)->whereNotNull('odometer')
+            ->when($exceptId, fn ($q) => $q->whereKeyNot($exceptId));
+        $before = (clone $base)->whereDate('entry_date', '<', $date)->max('odometer');
+        $after = (clone $base)->whereDate('entry_date', '>', $date)->min('odometer');
+        if ($before !== null && $km < (int) $before) {
+            throw ValidationException::withMessages(['odometer' => $vehicle->reg_no . ' already read ' . number_format((int) $before) . ' km before this date.']);
+        }
+        if ($after !== null && $km > (int) $after) {
+            throw ValidationException::withMessages(['odometer' => $vehicle->reg_no . ' read only ' . number_format((int) $after) . ' km after this date.']);
+        }
+        if ($vehicle->opening_odometer && $km < (int) $vehicle->opening_odometer) {
+            throw ValidationException::withMessages(['odometer' => $vehicle->reg_no . ' started at ' . number_format((int) $vehicle->opening_odometer) . ' km.']);
+        }
+    }
+
+    private function clean(?string $v, int $max): ?string
+    {
+        $v = trim((string) $v);
+
+        return $v === '' ? null : mb_substr($v, 0, $max);
+    }
+}
diff --git a/app/Services/Fleet/FuelPayouts.php b/app/Services/Fleet/FuelPayouts.php
new file mode 100644
index 0000000..4e8e092
--- /dev/null
+++ b/app/Services/Fleet/FuelPayouts.php
@@ -0,0 +1,178 @@
+<?php
+
+namespace App\Services\Fleet;
+
+use App\Models\AccountPayment;
+use App\Models\Bank;
+use App\Models\Expense;
+use App\Models\ExpenseType;
+use App\Models\Field;
+use App\Models\FuelEntry;
+use App\Models\FuelPayout;
+use App\Services\Banking\AccountBook;
+use Carbon\Carbon;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+
+/**
+ * Paying for fuel, the overtime way: approved fill-ups are "owed"; finance pays an office's
+ * fuel for a period (optionally one station's bill) in one go. That makes ONE expense (type
+ * Fuel, the office, the total) and ONE payment (category Fuel) from a bank or Main Cash, so
+ * the statement shows one line and the cash book shows it under Fuel.
+ *
+ * Unlike overtime there is nothing to hand out afterwards (the fuel is already in the tank),
+ * so a pay-out is paid at once; a mistake is cancelled (payment reversed, entries owed again).
+ */
+class FuelPayouts
+{
+    public function __construct(private AccountBook $book)
+    {
+    }
+
+    /** Approved fuel not on any pay-out yet. */
+    public function owed(?array $fieldIds = null, ?Carbon $from = null, ?Carbon $to = null, ?string $station = null): Collection
+    {
+        return FuelEntry::with(['vehicle', 'field', 'driver'])->owed()
+            ->when($fieldIds !== null, fn ($q) => $q->whereIn('field_id', $fieldIds ?: [0]))
+            ->when($from, fn ($q) => $q->whereDate('entry_date', '>=', $from->toDateString()))
+            ->when($to, fn ($q) => $q->whereDate('entry_date', '<=', $to->toDateString()))
+            ->when($station, fn ($q) => $q->where('station', $station))
+            ->orderBy('entry_date')->orderBy('id')
+            ->get();
+    }
+
+    /**
+     * @param  array{field_id:int, period_from:string, period_to:string, fuel_ids:array<int>, bank_id:int,
+     *               payee:string, pay_method?:?string, reference?:?string, payment_date?:?string,
+     *               station?:?string, notes?:?string}  $input
+     */
+    public function create(array $input): FuelPayout
+    {
+        $from = Carbon::parse($input['period_from'])->startOfDay();
+        $to = Carbon::parse($input['period_to'])->startOfDay();
+        if ($from->gt($to)) {
+            throw ValidationException::withMessages(['period_to' => 'The period ends before it starts.']);
+        }
+        $ids = array_values(array_unique(array_map('intval', array_filter((array) ($input['fuel_ids'] ?? [])))));
+        if (! $ids) {
+            throw ValidationException::withMessages(['fuel_ids' => 'Tick the fuel entries this pay-out covers.']);
+        }
+        $payee = trim((string) ($input['payee'] ?? ''));
+        if ($payee === '') {
+            throw ValidationException::withMessages(['payee' => 'Who is paid — the fuel station, or the person who bought the fuel?']);
+        }
+        $station = trim((string) ($input['station'] ?? '')) ?: null;
+
+        return DB::transaction(function () use ($input, $from, $to, $ids, $payee, $station) {
+            $field = Field::findOrFail((int) $input['field_id']);
+            $entries = FuelEntry::whereIn('id', $ids)->lockForUpdate()->get();
+            $bad = $entries->filter(fn (FuelEntry $f) => $f->status_3 !== 'approved' || $f->payout_id
+                || (int) $f->field_id !== $field->id || $f->entry_date->lt($from) || $f->entry_date->gt($to)
+                || ($station && $f->station !== $station))->pluck('id')
+                ->merge(array_diff($ids, $entries->pluck('id')->all()));
+            if ($bad->isNotEmpty()) {
+                throw ValidationException::withMessages(['fuel_ids' => 'Fuel #' . $bad->implode(', #')
+                    . ' is not approved, already paid, or not ' . $field->name . ' fuel between those dates. Refresh and try again.']);
+            }
+            $total = round((float) $entries->sum('amount'), 2);
+            if ($total <= 0) {
+                throw ValidationException::withMessages(['fuel_ids' => 'The ticked entries add up to GH₵ 0.00.']);
+            }
+
+            $bank = Bank::find((int) ($input['bank_id'] ?? 0));
+            if (! $bank) {
+                throw ValidationException::withMessages(['bank_id' => 'Choose the account the money comes from.']);
+            }
+            $payMethod = $bank->isCash() ? 'cash' : (string) ($input['pay_method'] ?? 'cheque');
+
+            $payout = FuelPayout::create([
+                'field_id' => $field->id,
+                'period_from' => $from,
+                'period_to' => $to,
+                'station' => $station,
+                'payee' => mb_substr($payee, 0, 150),
+                'bank_id' => $bank->id,
+                'total' => $total,
+                'litres' => round((float) $entries->sum('litres'), 2),
+                'notes' => ($n = trim((string) ($input['notes'] ?? ''))) === '' ? null : mb_substr($n, 0, 500),
+                'user_id' => Auth::id(),
+            ]);
+            FuelEntry::whereIn('id', $ids)->update(['payout_id' => $payout->id]);
+
+            $vehicles = $entries->load('vehicle')->pluck('vehicle.reg_no')->filter()->unique();
+            $description = $payout->label() . ' · ' . count($ids) . ' fill-ups, ' . number_format($payout->litres, 2) . ' L'
+                . ($vehicles->count() <= 4 ? ' · ' . $vehicles->implode(', ') : ' · ' . $vehicles->count() . ' vehicles');
+
+            $expense = Expense::create([
+                'description' => mb_substr($description, 0, 255),
+                'amount' => $total,
+                'expense_date' => $to->toDateString(),
+                'field_id' => $field->id,
+                'expense_type_id' => self::fuelType()->id,
+                // Each fill-up went through the approval chain; the pay-out itself is raised by finance.
+                'user_1' => Auth::id(), 'status_1' => 'approved', 'date_1' => now(),
+                'user_2' => Auth::id(), 'status_2' => 'approved', 'date_2' => now(),
+                'user_3' => Auth::id(), 'status_3' => 'approved',
+            ]);
+
+            $payment = $this->book->pay([
+                'bank_id' => $bank->id,
+                'payee' => $payout->payee,
+                'method' => $payMethod,
+                'reference' => $input['reference'] ?? null,
+                'payment_date' => $input['payment_date'] ?? now()->toDateString(),
+                'category' => 'fuel',
+                'description' => $description,
+                'expense_ids' => [$expense->id],
+            ]);
+
+            $payout->payment_id = $payment->id;
+            $payout->expense_id = $expense->id;
+            $payout->save();
+
+            return $payout->fresh();
+        });
+    }
+
+    /** Undo a pay-out entered in error: the payment is reversed and the fuel is owed again. */
+    public function cancel(FuelPayout $payout, string $reason): FuelPayout
+    {
+        $reason = trim($reason);
+        if (mb_strlen($reason) < 5) {
+            throw ValidationException::withMessages(['cancel_reason' => 'Give a reason (at least 5 characters).']);
+        }
+
+        return DB::transaction(function () use ($payout, $reason) {
+            $payout = FuelPayout::whereKey($payout->id)->lockForUpdate()->firstOrFail();
+            if ($payout->status === 'cancelled') {
+                throw ValidationException::withMessages(['cancel_reason' => 'Already cancelled.']);
+            }
+            if ($payout->payment_id) {
+                $payment = AccountPayment::findOrFail($payout->payment_id);
+                if ($payment->status !== 'cancelled') {
+                    $this->book->cancelPayment($payment, 'Fuel pay-out #' . $payout->id . ' cancelled: ' . $reason);
+                }
+            }
+            if ($payout->expense_id) {
+                Expense::whereKey($payout->expense_id)->delete();
+            }
+            FuelEntry::where('payout_id', $payout->id)->update(['payout_id' => null]);
+
+            $payout->status = 'cancelled';
+            $payout->cancelled_at = now();
+            $payout->cancelled_by = Auth::id();
+            $payout->cancel_reason = mb_substr($reason, 0, 500);
+            $payout->save();
+
+            return $payout;
+        });
+    }
+
+    public static function fuelType(): ExpenseType
+    {
+        return ExpenseType::whereRaw('LOWER(TRIM(name)) = ?', ['fuel'])->orderByRaw("CASE WHEN scope = 'field' THEN 0 ELSE 1 END")->first()
+            ?? ExpenseType::create(['name' => 'Fuel', 'scope' => 'field', 'created_by' => Auth::id()]);
+    }
+}
diff --git a/app/Services/Fleet/FuelSheetImport.php b/app/Services/Fleet/FuelSheetImport.php
new file mode 100644
index 0000000..6fa8071
--- /dev/null
+++ b/app/Services/Fleet/FuelSheetImport.php
@@ -0,0 +1,170 @@
+<?php
+
+namespace App\Services\Fleet;
+
+use App\Models\Field;
+use App\Models\FuelEntry;
+use App\Models\Vehicle;
+use Carbon\Carbon;
+use Illuminate\Support\Facades\DB;
+use PhpOffice\PhpSpreadsheet\IOFactory;
+use PhpOffice\PhpSpreadsheet\Shared\Date as ExcelDate;
+
+/**
+ * Loads a FUEL REQUEST AND USAGE REPORT sheet (DATE | DRIVER NAME | VEHICLE NO. | FIELD |
+ * Trip Destination | QUANTITY | UNITS | FUEL TYPE | FUEL REQUESTED | FUEL ISSUED | FUEL STATION |
+ * APPROVED BY | GRANTED BY | REMARK) into fuel entries, adding any vehicle not yet on the register.
+ *
+ * Re-runnable: a row already loaded (same vehicle, date, litres and amount) is skipped.
+ * Rows come in as submitted (to be reviewed), or fully approved with $approved (a sheet that
+ * was already signed off). Either way they are NOT paid: pay them through a fuel pay-out, or
+ * leave them unpaid if the money already went out of Main Cash.
+ */
+class FuelSheetImport
+{
+    /** @return array{created:int, skipped:int, vehicles:array<string>, errors:array<string>} */
+    public function import(string $path, ?int $fieldId = null, bool $approved = false, bool $dryRun = false, ?int $userId = null): array
+    {
+        $sheet = IOFactory::load($path)->getActiveSheet();
+        $rows = $sheet->toArray(null, true, false, false);
+
+        $header = null;
+        foreach ($rows as $i => $r) {
+            if (strtoupper(trim((string) ($r[0] ?? ''))) === 'DATE') {
+                $header = $i;
+                break;
+            }
+        }
+        if ($header === null) {
+            return ['created' => 0, 'skipped' => 0, 'vehicles' => [], 'errors' => ['No header row starting with DATE was found.']];
+        }
+        $cols = [];
+        foreach ($rows[$header] as $c => $name) {
+            $cols[strtoupper(trim((string) $name))] = $c;
+        }
+        $col = fn (array $r, string $name) => isset($cols[$name]) ? $r[$cols[$name]] : null;
+
+        $out = ['created' => 0, 'skipped' => 0, 'vehicles' => [], 'errors' => []];
+        $fields = Field::all();
+
+        DB::beginTransaction();
+        try {
+            foreach (array_slice($rows, $header + 1, null, true) as $i => $r) {
+                $line = $i + 1;
+                $reg = Vehicle::normaliseReg((string) $col($r, 'VEHICLE NO.'));
+                $amount = round((float) ($col($r, 'FUEL ISSUED') ?: $col($r, 'FUEL REQUESTED')), 2);
+                if ($reg === '' || $amount <= 0) {
+                    continue;   // blank lines and the TOTAL line
+                }
+                $date = $this->date($col($r, 'DATE'));
+                if (! $date) {
+                    $out['errors'][] = "Row {$line}: date not understood.";
+                    continue;
+                }
+                $field = $fieldId ? $fields->firstWhere('id', $fieldId) : $this->field($fields, (string) $col($r, 'FIELD'));
+                if (! $field) {
+                    $out['errors'][] = "Row {$line}: office \"" . trim((string) $col($r, 'FIELD')) . '" not found (use --field).';
+                    continue;
+                }
+                $type = str_contains(strtolower((string) $col($r, 'FUEL TYPE')), 'diesel') ? 'diesel' : (str_contains(strtolower((string) $col($r, 'FUEL TYPE')), 'super') || str_contains(strtolower((string) $col($r, 'FUEL TYPE')), 'petrol') ? 'super' : 'other');
+                $vehicle = Vehicle::firstOrCreate(['reg_no' => $reg], [
+                    'kind' => str_starts_with($reg, 'M-') ? 'motorbike' : 'car', 'fuel_type' => $type, 'field_id' => $field->id,
+                    'driver_name' => trim((string) $col($r, 'DRIVER NAME')) ?: null, 'status' => 'active', 'user_id' => $userId,
+                ]);
+                if ($vehicle->wasRecentlyCreated) {
+                    $out['vehicles'][] = $reg;
+                }
+                $price = round((float) $col($r, 'UNITS'), 3) ?: null;
+                $litres = round((float) $col($r, 'QUANTITY'), 2) ?: ($price ? round($amount / $price, 2) : 0);
+                if ($litres <= 0) {
+                    $out['errors'][] = "Row {$line}: no litres or price per litre.";
+                    continue;
+                }
+
+                $exists = FuelEntry::where('vehicle_id', $vehicle->id)->whereDate('entry_date', $date->toDateString())
+                    ->where('amount', $amount)->where('litres', $litres)->exists();
+                if ($exists) {
+                    $out['skipped']++;
+                    continue;
+                }
+                $note = trim(implode(' · ', array_filter([
+                    ($a = trim((string) $col($r, 'APPROVED BY'))) ? 'Approved by ' . $a : null,
+                    ($g = trim((string) $col($r, 'GRANTED BY'))) ? 'granted by ' . $g : null,
+                    trim((string) $col($r, 'REMARK')) ?: null,
+                    'imported from sheet',
+                ])));
+                $entry = new FuelEntry([
+                    'entry_date' => $date->toDateString(), 'vehicle_id' => $vehicle->id, 'field_id' => $field->id,
+                    'driver_name' => trim((string) $col($r, 'DRIVER NAME')) ?: null,
+                    'purpose' => mb_substr(trim((string) $col($r, 'TRIP DESTINATION')), 0, 150) ?: null,
+                    'fuel_type' => $type, 'litres' => $litres, 'price_per_litre' => $price ?? round($amount / $litres, 3),
+                    'amount_requested' => round((float) $col($r, 'FUEL REQUESTED'), 2) ?: $amount, 'amount' => $amount,
+                    'station' => mb_substr(strtoupper(trim((string) $col($r, 'FUEL STATION'))), 0, 100) ?: null,
+                    'notes' => mb_substr($note, 0, 500),
+                ]);
+                $entry->user_1 = $userId;
+                $entry->status_1 = 'approved';
+                $entry->date_1 = now();
+                if ($approved) {
+                    foreach ([2, 3] as $n) {
+                        $entry->{"user_{$n}"} = $userId;
+                        $entry->{"status_{$n}"} = 'approved';
+                        $entry->{"date_{$n}"} = now();
+                    }
+                }
+                $entry->save();
+                $out['created']++;
+            }
+            $dryRun ? DB::rollBack() : DB::commit();
+        } catch (\Throwable $e) {
+            DB::rollBack();
+            throw $e;
+        }
+
+        return $out;
+    }
+
+    private function date(mixed $v): ?Carbon
+    {
+        try {
+            if (is_numeric($v)) {
+                return Carbon::instance(ExcelDate::excelToDateTimeObject((float) $v))->startOfDay();
+            }
+            $s = trim((string) $v);
+            if ($s === '') {
+                return null;
+            }
+            foreach (['d/m/Y', 'd.m.y', 'd.m.Y', 'd-m-Y', 'Y-m-d'] as $f) {
+                $d = \DateTime::createFromFormat('!' . $f, $s);
+                if ($d) {
+                    return Carbon::instance($d);
+                }
+            }
+
+            return Carbon::parse($s)->startOfDay();
+        } catch (\Throwable) {
+            return null;
+        }
+    }
+
+    /** "ASHALEY BOTWE" finds Botwe; "Accra" finds ACCRA. */
+    private function field($fields, string $name): ?Field
+    {
+        $n = strtolower(trim($name));
+        if ($n === '') {
+            return null;
+        }
+        $exact = $fields->first(fn ($f) => strtolower(trim($f->name)) === $n);
+        if ($exact) {
+            return $exact;
+        }
+        $matches = $fields->filter(fn ($f) => str_contains($n, strtolower(trim($f->name))) || str_contains(strtolower(trim($f->name)), $n));
+        if ($matches->count() === 1) {
+            return $matches->first();
+        }
+        $words = array_filter(preg_split('/[^a-z]+/', $n), fn ($w) => strlen($w) > 3);
+        $byWord = $fields->filter(fn ($f) => collect($words)->contains(fn ($w) => str_contains(strtolower($f->name), $w)));
+
+        return $byWord->count() === 1 ? $byWord->first() : null;
+    }
+}

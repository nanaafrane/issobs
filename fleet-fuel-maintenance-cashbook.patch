@@ -0,0 +1,79 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Exports\CashBookExport;
+use App\Models\Bank;
+use App\Services\Banking\CashBook;
+use Carbon\Carbon;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+use Maatwebsite\Excel\Facades\Excel;
+
+/**
+ * The analysed cash book: Main Cash (or any account, or all of them) for a month, every line
+ * spread over its items, and the total spent on each item at month end — the uploaded Main
+ * Cash sheet, built from the ledger.
+ */
+class CashBookController extends Controller
+{
+    public function __construct(private CashBook $book)
+    {
+        $this->middleware('auth');
+    }
+
+    public function index(Request $request)
+    {
+        abort_unless(Auth::user()?->hasRole(BankController::VIEW_ROLES), 403);
+        [$bank, $from, $to] = $this->inputs($request);
+        $a = $this->book->analysis($bank, $from, $to);
+        $accounts = Bank::orderByRaw("CASE WHEN kind = 'cash' THEN 0 ELSE 1 END")->orderBy('name')->get();
+
+        return view('banks.cash_book', compact('a', 'accounts'));
+    }
+
+    public function export(Request $request)
+    {
+        abort_unless(Auth::user()?->hasRole(BankController::VIEW_ROLES), 403);
+        [$bank, $from, $to] = $this->inputs($request);
+        $a = $this->book->analysis($bank, $from, $to);
+
+        $summary = [['TOTAL SPENT PER ITEM ' . strtoupper($from->format('d M Y') . ' – ' . $to->format('d M Y'))],
+            array_merge(['ITEM', ''], $a['offices']->map(fn ($o) => strtoupper($o))->all(), ['TOTAL'])];
+        foreach ($a['items'] as $item => $total) {
+            $summary[] = array_merge([$item, ''], $a['offices']->map(fn ($o) => $a['matrix'][$item][$o] ?? null)->all(), [$total]);
+        }
+        $summary[] = array_merge(['TOTAL', ''], $a['offices']->map(fn ($o) => round(collect($a['matrix'])->sum(fn ($r) => (float) ($r[$o] ?? 0)), 2))->all(), [$a['analysed']]);
+
+        $name = strtoupper(str_replace(' ', '_', ($bank?->name ?? 'All_accounts') . '_' . $from->format('M_Y'))) . '_CASH_BOOK.xlsx';
+
+        return Excel::download(new CashBookExport($this->book->sheet($a), $summary, $from->format('M Y')), $name);
+    }
+
+    /** @return array{0: ?Bank, 1: Carbon, 2: Carbon} */
+    private function inputs(Request $request): array
+    {
+        $bank = null;
+        if ($request->input('bank') !== 'all') {
+            $bank = $request->integer('bank')
+                ? Bank::findOrFail($request->integer('bank'))
+                : (Bank::where('kind', 'cash')->operating()->orderBy('id')->first() ?? Bank::orderBy('id')->first());
+        }
+        try {
+            if ($request->filled('from') && $request->filled('to')) {
+                $from = Carbon::parse($request->input('from'))->startOfDay();
+                $to = Carbon::parse($request->input('to'))->startOfDay();
+            } else {
+                $from = Carbon::parse(($request->input('month') ?: now()->format('Y-m')) . '-01')->startOfMonth();
+                $to = $from->copy()->endOfMonth()->startOfDay();
+            }
+        } catch (\Throwable) {
+            [$from, $to] = [now()->startOfMonth(), now()->endOfMonth()->startOfDay()];
+        }
+        if ($from->gt($to)) {
+            [$from, $to] = [$to, $from];
+        }
+
+        return [$bank, $from, $to];
+    }
+}
diff --git a/app/Http/Controllers/Concerns/FleetScope.php b/app/Http/Controllers/Concerns/FleetScope.php
new file mode 100644
index 0000000..421ffb0
--- /dev/null
+++ b/app/Http/Controllers/Concerns/FleetScope.php
@@ -0,0 +1,75 @@
+<?php
+
+namespace App\Http\Controllers\Concerns;
+
+use App\Http\Controllers\BankController;
+use App\Models\Field;
+use Carbon\Carbon;
+use Illuminate\Support\Facades\Auth;
+
+/**
+ * Who sees which fleet records: head-office finance (Invoice, Finance Manager, Director) and
+ * Operations managers see every office; anyone else sees their own office and its sub-offices
+ * (Tema sees Tema and Shai Hills), the rule overtime pay-outs use.
+ */
+trait FleetScope
+{
+    /** @return array<int>|null null = every office */
+    protected function allowedFieldIds(): ?array
+    {
+        $user = Auth::user();
+        if ($this->seesAllOffices()) {
+            return null;
+        }
+
+        return Field::managedIds($user?->field_id ? (int) $user->field_id : null);
+    }
+
+    protected function seesAllOffices(): bool
+    {
+        $user = Auth::user();
+
+        return ($user?->hasRole(BankController::VIEW_ROLES) ?? false)
+            || ($user?->department?->name === 'Operations' && ($user?->hasRole(['Manager']) ?? false));
+    }
+
+    /** Head-office finance raises pay-outs and manages maintenance types. */
+    protected function isFinance(): bool
+    {
+        return Auth::user()?->hasRole(BankController::VIEW_ROLES) ?? false;
+    }
+
+    protected function mustSeeField(?int $fieldId): void
+    {
+        $allowed = $this->allowedFieldIds();
+        abort_if($allowed !== null && ! in_array((int) $fieldId, $allowed, true), 403, 'This belongs to another office.');
+    }
+
+    protected function visibleFields()
+    {
+        $allowed = $this->allowedFieldIds();
+
+        return Field::when($allowed !== null, fn ($q) => $q->whereIn('id', $allowed ?: [0]))->orderBy('name')->get();
+    }
+
+    /** @return array{0: Carbon, 1: Carbon} a month (?month=2026-10) or a from/to range, default this month */
+    protected function period($request): array
+    {
+        try {
+            if ($request->filled('from') || $request->filled('to')) {
+                $from = Carbon::parse($request->input('from', now()->startOfMonth()))->startOfDay();
+                $to = Carbon::parse($request->input('to', now()))->startOfDay();
+            } else {
+                $from = Carbon::parse(($request->input('month') ?: now()->format('Y-m')) . '-01')->startOfMonth();
+                $to = $from->copy()->endOfMonth()->startOfDay();
+            }
+        } catch (\Throwable) {
+            [$from, $to] = [now()->startOfMonth(), now()->endOfMonth()->startOfDay()];
+        }
+        if ($from->gt($to)) {
+            [$from, $to] = [$to, $from];
+        }
+
+        return [$from, $to];
+    }
+}
diff --git a/app/Http/Controllers/FuelController.php b/app/Http/Controllers/FuelController.php
new file mode 100644
index 0000000..7883f22
